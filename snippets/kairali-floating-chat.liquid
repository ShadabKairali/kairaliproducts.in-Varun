{%- comment -%}
  Chatbase product and website assistant. Public-catalogue and support intents
  only: it holds no Shopify Admin credentials and performs no private order or
  customer lookup.

  The third-party runtime loads only after the visitor chooses this launcher.
  It never loads on idle, scroll, general pointer activity or keyboard activity.
{%- endcomment -%}
{%- unless request.page_type == 'password' -%}
  <button type="button" class="kairali-priya-launcher" id="kairali-priya-launcher">
    Chat with Priya
  </button>

  <p class="kairali-priya-status sr-only" id="kairali-priya-status" role="status" aria-live="polite"></p>

<script>
  (function () {
    var agentId = 'YY8Rms7pyDevUZ-TURCKc';
    var embedDomain = 'www.chatbase.co';
    var publicInitialMessages = [
      'Namaste. I’m Priya, Kairali’s AI product and website assistant.',
      'Ask about products, pack sizes, current availability, website navigation, Professional & Bulk enquiries or contract manufacturing.',
      'For medical advice, diagnosis, treatment or private order details, please contact the appropriate Kairali team.'
    ];
    var publicSuggestedMessages = [
      'Find a product',
      'Check pack size and availability',
      'Professional & Bulk enquiry',
      'Contract manufacturing enquiry'
    ];
    var publicFooter = 'Kairali product & website assistant | info@kairali.com | WhatsApp: +91 92898 38797';
    var launcher = document.getElementById('kairali-priya-launcher');
    var status = document.getElementById('kairali-priya-status');
    var loading = false;
    var activeScript = null;
    var displayCopyApplied = false;
    var openRequested = false;
    var initializationTimer = 0;
    var initializationTimeoutMs = 12000;

    if (!launcher) return;

    function clearInitializationTimer() {
      if (!initializationTimer) return;
      window.clearTimeout(initializationTimer);
      initializationTimer = 0;
    }

    function setLauncherState(state) {
      var retry = state === 'retry';
      launcher.classList.toggle('is-retry', retry);
      launcher.textContent = retry ? 'Retry Priya' : 'Chat with Priya';
      if (retry) {
        launcher.setAttribute('title', 'Chat could not load. Retry or use WhatsApp.');
      } else {
        launcher.removeAttribute('title');
      }
    }

    function providerApiReady() {
      return !!(
        window.chatbase &&
        typeof window.chatbase.open === 'function' &&
        typeof window.chatbase.close === 'function' &&
        typeof window.chatbase.setOptions === 'function'
      );
    }

    function applyPublicDisplayCopy() {
      if (displayCopyApplied) return true;
      if (!providerApiReady()) return false;

      try {
        window.chatbase.setOptions({
          initialMessages: publicInitialMessages,
          suggestedMessages: publicSuggestedMessages,
          footer: publicFooter
        });
        displayCopyApplied = true;
        return true;
      } catch (error) {
        return false;
      }
    }

    function requestProviderOpen() {
      if (!providerApiReady() || !applyPublicDisplayCopy()) return false;
      if (openRequested) return true;

      try {
        window.chatbase.open();
        openRequested = true;
        return true;
      } catch (error) {
        return false;
      }
    }

    function providerIsUsable() {
      var bubbleWindow = document.getElementById('chatbase-bubble-window');
      var iframe = bubbleWindow && bubbleWindow.querySelector('iframe');
      if (!providerApiReady() || !bubbleWindow || !iframe) return false;

      var style = window.getComputedStyle(bubbleWindow);
      var rect = bubbleWindow.getBoundingClientRect();
      return style.display !== 'none' && style.visibility !== 'hidden' && rect.width > 0 && rect.height > 0;
    }

    function completeInitialization(script) {
      if (script !== activeScript) return;
      clearInitializationTimer();
      loading = false;
      activeScript = null;
      if (status) status.textContent = '';
      setLauncherState('ready');
      launcher.hidden = true;
    }

    function restoreLauncherAfterFailure(script) {
      if (script !== activeScript) return;
      clearInitializationTimer();
      loading = false;
      activeScript = null;
      openRequested = false;

      try {
        if (providerApiReady()) window.chatbase.close();
      } catch (error) { /* The retry control remains available. */ }

      if (script && script.parentNode) script.remove();
      ['chatbase-bubble-button', 'chatbase-bubble-window', 'chatbase-message-bubbles'].forEach(function (id) {
        var node = document.getElementById(id);
        if (node) node.remove();
      });
      try { delete window.chatbase; }
      catch (error) { window.chatbase = undefined; }
      displayCopyApplied = false;

      launcher.hidden = false;
      setLauncherState('retry');
      if (status) status.textContent = 'Chat could not load. Please try again or use WhatsApp.';
      launcher.focus();
    }

    function monitorInitialization(script) {
      var startedAt = Date.now();
      clearInitializationTimer();

      function check() {
        if (!loading || script !== activeScript) return;
        requestProviderOpen();
        if (providerIsUsable()) {
          completeInitialization(script);
          return;
        }
        if (Date.now() - startedAt >= initializationTimeoutMs) {
          restoreLauncherAfterFailure(script);
          return;
        }
        initializationTimer = window.setTimeout(check, 250);
      }

      initializationTimer = window.setTimeout(check, 0);
    }

    function loadPriya() {
      var existingScript = document.getElementById(agentId);
      setLauncherState('loading');
      launcher.hidden = true;
      if (status) status.textContent = 'Loading chat…';

      if (loading) return;
      loading = true;
      openRequested = false;

      if (existingScript && providerApiReady()) {
        activeScript = existingScript;
        monitorInitialization(existingScript);
        return;
      }

      if (existingScript) {
        existingScript.remove();
        try { delete window.chatbase; }
        catch (error) { window.chatbase = undefined; }
      }

      window.embeddedChatbotConfig = {
        chatbotId: agentId,
        domain: embedDomain
      };

      var script = document.createElement('script');
      script.src = 'https://' + embedDomain + '/embed.min.js';
      script.id = agentId;
      script.setAttribute('chatbotId', agentId);
      script.setAttribute('domain', embedDomain);
      script.async = true;
      activeScript = script;
      script.onload = function () {
        if (script === activeScript) requestProviderOpen();
      };
      script.onerror = function () {
        if (script === activeScript) restoreLauncherAfterFailure(script);
      };
      document.body.appendChild(script);
      monitorInitialization(script);
    }

    launcher.addEventListener('click', loadPriya);
  })();
</script>
{%- endunless -%}
