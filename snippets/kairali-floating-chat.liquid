{%- comment -%}
  Kairali India floating contact stack — WhatsApp plus Priya, the deferred
  Chatbase product assistant. Keep loading, fallback, accessibility and mobile
  offsets coupled in this single snippet.
{%- endcomment -%}

<style>
  .krl-fab {
    position: fixed;
    right: 1rem;
    bottom: calc(92px + var(--kairali-floating-clearance, 0px) + env(safe-area-inset-bottom, 0px));
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    text-decoration: none;
    line-height: 0;
    transition: transform .3s ease, box-shadow .3s ease, bottom .15s ease-in-out;
  }

  .krl-fab svg { display: block; width: 30px; height: 30px; position: relative; z-index: 1; }

  /* Shopify/Google injects this protection badge only when reCAPTCHA is
     required. Keep its native bottom offset and interaction, but place it on
     the opposite side so it cannot cover the WhatsApp launcher. */
  .grecaptcha-badge {
    left: 1rem !important;
    right: auto !important;
  }

  /* The pulse ring animates transform + opacity only, so it stays on the
     compositor. Animating box-shadow instead repaints every frame forever,
     which this store cannot afford — INP is its one failing Core Web Vital. */
  .krl-fab::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(37, 211, 102, .7);
    z-index: 0;
    will-change: transform, opacity;
    animation: krl-fab-pulse 1.5s ease-out infinite;
  }

  .krl-fab:hover,
  .krl-fab:focus-visible {
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(37, 211, 102, .7);
  }

  .krl-fab:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  @keyframes krl-fab-pulse {
    0%   { transform: scale(1);    opacity: .7; }
    70%  { transform: scale(1.36); opacity: 0; }
    100% { transform: scale(1.36); opacity: 0; }
  }

  /* WhatsApp stays above the right-aligned Chat with us control. */
  #chatbase-bubble-button {
    right: 1rem !important;
    bottom: calc(1rem + var(--kairali-floating-clearance, 0px) + env(safe-area-inset-bottom, 0px)) !important;
    width: 57px !important;
    height: 57px !important;
    z-index: 9998 !important;
  }

  #chatbase-bubble-window {
    right: 1rem !important;
    bottom: calc(5rem + var(--kairali-floating-clearance, 0px) + env(safe-area-inset-bottom, 0px)) !important;
    height: min(79vh, calc(100vh - 6rem - var(--kairali-floating-clearance, 0px) - env(safe-area-inset-bottom, 0px))) !important;
    height: min(79vh, calc(100dvh - 6rem - var(--kairali-floating-clearance, 0px) - env(safe-area-inset-bottom, 0px))) !important;
    z-index: 9999 !important;
  }

  .kairali-priya-launcher {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + var(--kairali-floating-clearance, 0px) + env(safe-area-inset-bottom, 0px));
    z-index: 9998;
    min-height: 48px;
    padding: .75rem 1rem;
    border: 0;
    border-radius: 999px;
    background: #27351d;
    color: #fff;
    font: 600 14px/1.2 inherit;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .2);
    cursor: pointer;
  }

  .kairali-priya-launcher:hover { background: #182211; }
  .kairali-priya-launcher:focus-visible { outline: 3px solid #ffbf47; outline-offset: 3px; }
  .kairali-priya-launcher::after { content: none; }

  .kairali-priya-status { position: fixed; right: 1rem; bottom: calc(8.5rem + env(safe-area-inset-bottom, 0px)); z-index: 9998; max-width: 18rem; }

  /* Clear the mobile sticky add-to-cart bar so neither widget covers it. */
  html:not(.kairali-floating-stack-ready) body:has(.product-sticky-bar.is-visible) .krl-fab {
    bottom: calc(140px + var(--sticky-area-height, 0px) + env(safe-area-inset-bottom, 0px));
  }

  html:not(.kairali-floating-stack-ready) body:has(.product-sticky-bar.is-visible) #chatbase-bubble-button {
    bottom: calc(1rem + var(--sticky-area-height, 0px) + 4.75rem + env(safe-area-inset-bottom, 0px)) !important;
  }

  html:not(.kairali-floating-stack-ready) body:has(.product-sticky-bar.is-visible) .kairali-priya-launcher {
    bottom: calc(1rem + var(--sticky-area-height, 0px) + 4.75rem + env(safe-area-inset-bottom, 0px));
  }

  @media screen and (max-width: 749px) {
    .kairali-priya-launcher {
      width: auto;
      min-width: 0;
      padding-inline: 1rem;
      font-size: 14px !important;
      letter-spacing: normal;
    }
    .kairali-priya-launcher.is-retry::after { content: "RETRY"; font-size: 11px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .krl-fab { transition: none; }
    .krl-fab::after { animation: none; opacity: 0; }
  }
</style>

<script>
  (function () {
    var root = document.documentElement;
    var watched = new WeakSet();
    var resizeObserver = new ResizeObserver(schedule);
    var attributeObserver = new MutationObserver(schedule);
    var frame = 0;

    function schedule() {
      if (frame) return;
      frame = requestAnimationFrame(updateClearance);
    }

    function watchTargets() {
      document.querySelectorAll('#gropulse-consent-banner-wrapper, #gropulse-consent-banner, #es-sticky, .product-sticky-bar').forEach(function (node) {
        if (watched.has(node)) return;
        watched.add(node);
        resizeObserver.observe(node);
        attributeObserver.observe(node, { attributes: true, attributeFilter: ['class', 'style', 'hidden'] });
      });
    }

    function updateClearance() {
      frame = 0;
      watchTargets();
      var clearance = 0;
      var consentWrapper = document.getElementById('gropulse-consent-banner-wrapper');
      var consentVisible = false;

      if (consentWrapper) {
        var consentStyle = getComputedStyle(consentWrapper);
        var consentRect = consentWrapper.getBoundingClientRect();
        consentVisible = consentStyle.display !== 'none' &&
          consentStyle.visibility !== 'hidden' &&
          Number(consentStyle.opacity || 1) > 0 &&
          consentRect.width > 0 &&
          consentRect.height > 0;
      }

      root.classList.toggle('kairali-consent-open', consentVisible);
      document.querySelectorAll('#gropulse-consent-banner, #es-sticky, .product-sticky-bar.is-visible').forEach(function (node) {
        var style = getComputedStyle(node);
        var rect = node.getBoundingClientRect();
        var visible = style.display !== 'none' && style.visibility !== 'hidden' && Number(style.opacity || 1) > 0;
        var bottomDocked = rect.height > 0 && rect.bottom >= window.innerHeight - 2 && rect.top < window.innerHeight;
        if (visible && bottomDocked) clearance = Math.max(clearance, window.innerHeight - rect.top + 8);
      });
      root.style.setProperty('--kairali-floating-clearance', Math.ceil(clearance) + 'px');
      root.classList.add('kairali-floating-stack-ready');
    }

    new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true });
    window.addEventListener('resize', schedule, { passive: true });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule, { once: true });
    else schedule();
  })();
</script>

<a
  class="krl-fab"
  href="https://wa.me/919289838797?text={{ 'Hi Kairali, I am contacting you from kairaliproducts.in about ' | append: canonical_url | append: '. I need help with: ' | url_encode }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Kairali on WhatsApp (opens in a new tab)"
>
