{% assign shop_promo_1_img = 'shopify://shop_images/Mega_menu_image_1.png' %}
{% assign shop_promo_1_heading = 'KAIRKARE BODY OIL' %}
{% assign shop_promo_1_sub = 'Classical herbal massage oil for deep relaxation.' %}
{% assign shop_promo_1_url = '/products/kairkare-ayurvedic-herbal-body-massage-oil' %}

{% assign shop_promo_2_img = 'shopify://shop_images/Mega_menu_image_4.png' %}
