{% assign shop_promo_2_url = '/products/shatavari-capsules-herbal-health-supplement-for-women' %}

{% for block in blocks %}
  {% assign block_title = block.settings.title | downcase | strip %}
  {% if block_title contains 'body' or block_title contains 'shop' %}
    {% if block.settings.desktop_image_1 %}
      {% assign shop_promo_1_img = block.settings.desktop_image_1 %}
      {% assign shop_promo_1_heading = block.settings.heading_1 | default: 'KAIRKARE BODY OIL' %}
      {% assign shop_promo_1_sub = block.settings.text_1 | default: 'Ayurvedic Body Massage Oil' %}
      {% assign shop_promo_1_url = block.settings.link_1 | default: '/products/kairkare-ayurvedic-herbal-body-massage-oil' %}
    {% endif %}
    {% if block.settings.desktop_image_2 %}
      {% assign shop_promo_2_img = block.settings.desktop_image_2 %}
      {% assign shop_promo_2_heading = block.settings.heading_2 | default: 'SHATAVARI CAPSULES' %}
      {% assign shop_promo_2_sub = block.settings.text_2 | default: 'Women’s Health & Vitality' %}
      {% assign shop_promo_2_url = block.settings.link_2 | default: '/products/shatavari-capsules-herbal-health-supplement-for-women' %}
    {% endif %}
  {% endif %}
{% endfor %}

