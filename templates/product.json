i\">\n  <div class=\"offer-header-kairali\" onclick=\"toggleOffers(this)\">\n    <div class=\"offer-header-left-kairali\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Kairali_Gift.png?v=1761124526\" alt=\"{{ product.metafields.custom.product_name }}\">\n      <span>Exclusive Offers & Deals</span>\n    </div>\n    <span class=\"offer-toggle-kairali\">−</span>\n  </div>\n\n  <div class=\"offer-content-kairali\" style=\"display:block;\">\n    <ul>\n        \n      \n\n      <li>\n        <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Li_Kairali.png?v=1761124527\" alt=\"{{ product.metafields.custom.product_name }}\">\n        <div><strong>GET 15% OFF</strong> On <a href=\"https://www.kairaliproducts.in/collections/kair-by-kairali-herbal-cosmetics-products\">Ayurvedic Anti-Pigmentation Kit.</a> <span class= \"tcspan\">T&C Apply</span></div>\n      </li>\n\n      <li>\n        <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Li_Kairali.png?v=1761124527\" alt=\"{{ product.metafields.custom.product_name }}\">\n        <div><strong>25% OFF</strong> on <a href=\"https://www.kairaliproducts.in/collections/kair-by-kairali-herbal-cosmetics-products\"> Kaircin Ayurvedic Facial Oil.</a> – Limited Time Only! <span class= \"tcspan\">T&C Apply</span></div>\n      </li>\n\n      <li>\n  <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Li_Kairali.png?v=1761124527\">\n  <div>\n    <span class=\"disc-highlited\">BUY MORE SAVE MORE</span> – Get <span class=\"disc-highlited1\">UP TO 20% OFF</span> on all products. \n    <span class=\"tcspan\">T&C Apply</span>\n  </div>\n</li>\n    </ul>\n  </div>\n</div>\n\n<script>\nfunction toggleOffers(header) {\n  const content = header.nextElementSibling;\n  const icon = header.querySelector(\".offer-toggle-kairali\");\n  const isOpen = content.style.display === \"block\";\n  content.style.display = isOpen ? \"none\" : \"block\";\n  icon.textContent = isOpen ? \"+\" : \"−\";\n  icon.classList.toggle(\"open\", !isOpen);\n}\n</script>"
