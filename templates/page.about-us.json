            "button_link": "https://kairalicenters.com/",
            "button_link_in_new_window": false,
            "desktop_image": "shopify://shop_images/Kairali_Ayurvedic_Center.png",
            "mobile_image": "shopify://shop_images/Kairali_Ayurvedic_Center.png"
          }
        },
        "column_aRtfbj": {
          "type": "column",
          "settings": {
            "heading": "Kairali Guru",
            "heading_disable_on_mobile": false,
            "text": "<p>Kairali Guru is the educational and training wing of the Kairali Ayurvedic Group, committed to its common goal of spreading the wisdom of Ayurveda through structured courses, workshops, and certifications.</p>",
            "text_disable_on_mobile": false,
            "button_select": "primary",
