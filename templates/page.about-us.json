          "type": "column",
          "settings": {
            "heading": "Kairali – The Ayurvedic Healing Village",
            "heading_disable_on_mobile": false,
            "text": "<p>Nestled in the lush greenery of Palakkad, Kerala, Kairali – The Ayurvedic Healing Village is a world-class wellness retreat that blends nature, Ayurveda, and luxury.</p>",
            "text_disable_on_mobile": false,
            "button_select": "primary",
