            "mobile_image": "shopify://shop_images/The_Kairali_Healing_Vilage.png"
          }
        },
        "column_Txn8Qb": {
          "type": "column",
          "settings": {
            "heading": "Kairali Ayurvedic Centre",
            "heading_disable_on_mobile": false,
            "text": "<p>With a legacy spanning over a century, Kairali Ayurvedic Centre was formally founded in 1989. With a satisfaction rate of over 93.9%, Kairali Ayurvedic Centre is a trusted name worldwide in holistic healing and wellness.</p>",
            "text_disable_on_mobile": false,
            "button_select": "primary",
