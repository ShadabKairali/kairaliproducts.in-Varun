        "collapsible_tab_hAKLRT": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Do you offer free Ayurvedic consultations?",
            "content": "<p>Yes! Get free online consultations from certified Ayurvedic doctors. Book directly via our website and receive personalized wellness advice tailored to your dosha and health goals.</p>",
