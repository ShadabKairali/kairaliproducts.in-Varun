    "custom_liquid_KW6xAP": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "FAQ Schema Jeson",
      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What is Kairali Ayurvedic Products?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Kairali Ayurvedic Products is a heritage Ayurvedic brand with over 80 years of expertise. We craft authentic wellness and skincare products using time-tested Ayurvedic formulations and high-quality natural ingredients—rooted in tradition, backed by science.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Are your products AYUSH certified?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes, all our Ayurvedic products are certified by AYUSH (Ministry of Ayurveda, Yoga & Naturopathy, Unani, Siddha and Homoeopathy), ensuring safety, authenticity, and compliance with India’s highest regulatory standards.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Are your products 100% natural and chemical-free?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Absolutely. We use only 100% natural herbs, organic extracts, and traditional ingredients—free from parabens, sulfates, silicones, or synthetic additives. Just pure Ayurveda in every bottle.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do Kairali products have any side effects?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Our formulations are made from natural ingredients and are generally safe for use. However, we recommend consulting a qualified Ayurvedic practitioner if you're pregnant, nursing, taking medication, or have a medical condition.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do you ensure product quality?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Every Kairali product goes through rigorous quality checks. Our in-house R&D team tests for purity, potency, and effectiveness before anything reaches your doorstep.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How is product packaging and delivery handled?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We take packaging seriously. Products are hygienically sealed, securely boxed, and double-checked for safety to ensure they arrive in perfect condition—whether it's across the street or across the globe.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do you offer international shipping?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes! We ship worldwide from our global website kairaliproducts.com. Shipping fees are calculated at checkout based on your location. Keep an eye out for seasonal discounts on international deliveries!\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I place an order by phone?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes, simply call our customer care team at +91-9555156156 to place an order manually. We’re happy to help.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long does delivery take?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"India: 5–7 business days. International: 7–16 business days. You’ll receive tracking updates via email/SMS once your order is dispatched.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do I track my order?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"You’ll get a tracking link via email or SMS. Click the link to follow your package in real-time.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How can I cancel my order?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Orders can be cancelled before they’re shipped. Contact our support team immediately at +91-9555156156 for assistance.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What if an item is missing from my order?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Oops! If something’s missing, please call our support team right away and we’ll sort it out with urgency.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I modify my order after placing it?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Unfortunately, once confirmed, orders cannot be changed. You’ll need to place a new order for any modifications.\"\n      }\n    },\n        {\n      \"@type\": \"Question\",\n      \"name\": \"Received damaged items?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We’re truly sorry! Contact us at +91-9555156156, and we’ll arrange a replacement or refund ASAP as per our policy.\"\n      }\n    },\n        {\n      \"@type\": \"Question\",\n      \"name\": \"What if I received the wrong item?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Mistakes happen, but we’ll fix it fast. Call our team and we’ll send you the correct item without delay.\"\n      }\n    },\n        {\n      \"@type\": \"Question\",\n      \"name\": \"Where can I download my invoice?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Currently, we do not offer the option to download invoices directly from our website. After placing your order, your invoice will be sent to your registered number provided during checkout. If you haven’t received it or need any assistance, please feel free to contact our support team at +91-9555156156‬ — we’ll be happy to help you.\"\n      }\n    },\n        {\n      \"@type\": \"Question\",\n      \"name\": \"What’s your return policy?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We accept returns within 7 days of delivery if the item is unused, unopened, and in its original packaging. Please refer to our full Return & Refund Policy for specifics.\"\n      }\n    },\n            {\n      \"@type\": \"Question\",\n      \"name\": \"How do I request a return or refund?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Contact our support team with your order number, and we’ll guide you through the return process step-by-step.\"\n      }\n    },\n            {\n      \"@type\": \"Question\",\n      \"name\": \"When will I get my refund?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Refunds are processed within 10–15 business days after approval and will be credited to your original payment method.\"\n      }\n    },\n            {\n      \"@type\": \"Question\",\n      \"name\": \"Do you offer free Ayurvedic consultations?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes! Get free online consultations from certified Ayurvedic doctors. Book directly via our website and receive personalized wellness advice tailored to your dosha and health goals.\"\n      }\n    },\n            {\n      \"@type\": \"Question\",\n      \"name\": \"How do I know which product is right for me?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Check our detailed product descriptions, or better yet—book a free Ayurvedic consultation to get recommendations based on your body type, health concerns, and lifestyle.\"\n      }\n    }\n  ]\n}\n</script>"
      }
    },
