        "template--15329436369096__19343041-49f3-4eb8-918f-d93e323afa2e-collapsible_tab-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "What is Kairali Ayurvedic Products?",
            "content": "<p>Kairali Ayurvedic Products is a heritage Ayurvedic brand with over 80 years of expertise. We craft authentic wellness and skincare products using time-tested Ayurvedic formulations and high-quality natural ingredients—rooted in tradition, backed by science.</p>",
            "page": "",
            "icon": "none"
          }
        },
        "6c6c8546-4be8-47e9-8694-d542109d388e": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Are your products AYUSH certified?",
            "content": "<p>Yes, all our Ayurvedic products are certified by AYUSH (Ministry of Ayurveda, Yoga & Naturopathy, Unani, Siddha and Homoeopathy), ensuring safety, authenticity, and compliance with India’s highest regulatory standards.</p>",
            "page": "",
            "icon": "none"
          }
        },
        "18a26329-3e89-409b-b175-cad7e9531a44": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Are your products 100% natural and chemical-free?",
            "content": "<p>Absolutely. We use only 100% natural herbs, organic extracts, and traditional ingredients—free from parabens, sulfates, silicones, or synthetic additives. Just pure Ayurveda in every bottle.</p>",
            "page": "",
            "icon": "none"
          }
        },
        "1587700a-5ee8-43f8-a35f-d929db42fb22": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Do Kairali products have any side effects?",
            "content": "<p>Our formulations are made from natural ingredients and are generally safe for use. However, we recommend consulting a qualified Ayurvedic practitioner if you're pregnant, nursing, taking medication, or have a medical condition.</p>",
            "page": "",
            "icon": "none"
          }
        },
        "bb27c4f2-0c26-45bf-8b45-d680bea4e03c": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How do you ensure product quality?",
            "content": "<p>Every Kairali product goes through rigorous quality checks. Our in-house R&D team tests for purity, potency, and effectiveness before anything reaches your doorstep.</p>",
            "page": "",
            "icon": "none"
          }
        },
        "2c2aaa13-82fb-4138-aa8a-37f18b412379": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How is product packaging and delivery handled?",
            "content": "<p>We take packaging seriously. Products are hygienically sealed, securely boxed, and double-checked for safety to ensure they arrive in perfect condition—whether it's across the street or across the globe.</p>",
            "page": "",
            "icon": "none"
          }
        }
      },
