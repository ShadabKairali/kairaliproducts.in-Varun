      ],
      "settings": {
        "custom_liquid": "<style>\n\n    .about-wrapper {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: space-between;\n      align-items: flex-start;\n      padding: 30px 40px;\n      gap: 40px;\n      margin-right: 7%;\n      margin-left: 7%;\n      max-width: 1200px;\n    }\n\n    /* LEFT SIDE */\n  .about-left,\n  .about-stats {\n    flex: 1;\n    min-width: 280px;\n      position: relative;\n    }\n    .about-content {\n      position: relative;\n      z-index: 1;\n    }\n\n    .about-content h2 {\n      font-weight: 700;\n      font-size: 40px;\n      font-family: \"Canto\";\n      line-height: 46px;\n      color: #000;\n      margin-bottom: 20px;\n      position: relative;\n      padding-right: 70px;\n      display: inline-block;\n      font-style: normal;\n    }\n\n    .about-content h2::after {\ncontent: \"\";\n  background-image: url('https://cdn.shopify.com/s/files/1/0925/8998/1983/files/after-line.svg');\n  background-size: contain;\n  background-repeat: no-repeat;\n  width: 60px;\n  height: 20px;\n  position: absolute;\n  top: 60%;\n  right: 0;\n  transform: translateY(-50%);\n\n    }\n\n    .about-content p {\n      font-family: \"Roboto\";\n      margin-bottom: 20px;\n      font-style: normal;\n      font-weight: 400;\n      font-size: 14px;\n      line-height: 22px;\n      color: #464646;\n    }\n\n    .know-more-btn {\n      display: inline-block;\n      background: #b8860b;\n      color: #fff;\n      font-weight: bold;\n      padding: 12px 30px;\n      border-radius: 25px;\n      text-decoration: none;\n      transition: background 0.3s ease;\n    }\n\n    .know-more-btn:hover {\n      background: #a37405;\n    }\n\n    /* RIGHT SIDE */\n    .about-stats {\n      flex: 1;\n      min-width: 300px;\n      max-width: 600px;\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 30px;\n    }\n\n    .about-stat {\n      text-align: center;\n    }\n\n    .about-stat .stat-number {\n      font-size: 24px;\n      font-weight: bold;\n      color: #7a711f;\n    }\n\n    .about-stat .stat-label {\n      font-size: 16px;\n      margin-bottom: 12px;\n      color: #333;\n    }\n\n    .stat-icon-box {\n      border: 2px solid #b8a44a;\n      border-radius: 16px;\n      padding: 30px 20px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100px;\n    }\n\n    .stat-icon-box img {\n      max-height: 100px;\n      max-width: 100%;\n    }\n\n    @media (max-width: 992px) {\n      .about-wrapper {\n        flex-direction: column;\n        padding: 30px 20px;\n        width: 90%;\n        margin-left: 10px;\n        margin-right: 10px;\n      }\n\n      .about-stats {\n        grid-template-columns: 1fr 1fr;\n        gap: 20px;\n      }\n    }\n\n  @media (max-width: 600px) {\n    .about-content h2 {\n      font-size: 32px;\n      line-height: 40px;\n      padding-right: 50px;\n    }\n\n    .about-stats {\n      grid-template-columns: 1fr;\n    }\n  }\n  </style>\n\n\n<section class=\"about-wrapper\">\n  <!-- LEFT SIDE -->\n  <div class=\"about-left\">\n    <div class=\"about-content\">\n      <h2>About Us</h2>\n      <p>\n        Kairali Ayurvedic Products is a globally renowned Ayurvedic & Herbal products manufacturer and supplier,\n        specializing in the production of authentic Ayurvedic products. With a legacy spanning over eight decades,\n        Kairali Ayurvedic Products is committed to preserving the ancient wisdom of Ayurveda while incorporating\n        modern manufacturing practices.\n      </p>\n      <p>\n        Our state-of-the-art manufacturing facility, located in Pollachi, Tamil Nadu, adheres to strict quality\n        control measures and is equipped with advanced technology to ensure the highest quality and purity standards\n        in every product. We offer comprehensive contract manufacturing services, including formulation development,\n        sourcing of raw materials, production, packaging, and quality assurance.\n      </p>\n      <a href=\"#\" class=\"know-more-btn\">KNOW MORE</a>\n    </div>\n  </div>\n\n  <!-- RIGHT SIDE -->\n  <div class=\"about-stats\">\n    <div class=\"about-stat\">\n      <div class=\"stat-number\">10000+</div>\n      <div class=\"stat-label\">Satisfied Clients</div>\n      <div class=\"stat-icon-box\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Satisfied_Clients.png\" alt=\"Client Icon\">\n      </div>\n    </div>\n    <div class=\"about-stat\">\n      <div class=\"stat-number\">1200+</div>\n      <div class=\"stat-label\">Total Distributors</div>\n      <div class=\"stat-icon-box\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Happy_Distributors.png\" alt=\"Distributors Icon\">\n      </div>\n    </div>\n    <div class=\"about-stat\">\n      <div class=\"stat-number\">900+</div>\n      <div class=\"stat-label\">Product SKUs</div>\n      <div class=\"stat-icon-box\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Product_SKUs.png\" alt=\"Products Icon\">\n      </div>\n    </div>\n    <div class=\"about-stat\">\n      <div class=\"stat-number\">111+</div>\n      <div class=\"stat-label\">Years of Experience</div>\n      <div class=\"stat-icon-box\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Years_of_experience.png\" alt=\"Experience Icon\">\n      </div>\n    </div>\n  </div>\n</section>"
      }
