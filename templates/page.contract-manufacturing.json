      "name": "Services",
      "settings": {
        "custom_liquid": "<style>\n\n\n    .feature-section {\n      padding: 60px 40px;\n      background-color: #fff;\n      max-width: 86%;\n      border-radius: 20px;\n      margin: 0px auto;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 30px;\n    }\n\n    .feature-box {\n      background: #fff;\n      border-radius: 20px;\n      text-align: center;\n      padding: 10px 10px;\n      box-shadow: 0px 6px 8px rgba(0, 0, 0, 0.08);\n      border-top: 4px solid #7a711f;\n      border-bottom: 4px solid #7a711f;\n      transition: all 0.3s ease;\n    }\n\n    .feature-box:hover {\n      transform: translateY(-6px);\n      box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.1);\n    }\n\n    .feature-icon {\n      height: 110px;\n      margin-bottom: 20px;\n      margin-top: 10px;\n    }\n\n    .feature-title {\n      font-size: 18px;\n      color: #7a711f;\n      font-weight: 600;\n      margin-bottom: 10px;\n      line-height: 1.4;\n    }\n\n    .feature-desc {\n      font-size: 14px;\n      color: #333;\n      line-height: 1.6;\n      margin-bottom: 10px;\n    }\n\n    @media (max-width: 1024px) {\n      .feature-grid {\n        grid-template-columns: repeat(2, 1fr);\n      }\n    }\n\n    @media (max-width: 600px) {\n      .feature-grid {\n        grid-template-columns: 1fr;\n      }\n    }\n  </style>\n\n<body>\n\n<section class=\"feature-section\">\n  <div class=\"feature-grid\">\n\n    <div class=\"feature-box\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Quick_Services.png\" alt=\"Quick Services\" class=\"feature-icon\">\n      <div class=\"feature-title\">Quick Services</div>\n      <div class=\"feature-desc\">\n        Prompt response, fast deliveries,<br>\n        and reliable courier partners\n      </div>\n    </div>\n\n    <div class=\"feature-box\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Best_Price.png\" alt=\"Best Price\" class=\"feature-icon\">\n      <div class=\"feature-title\">Best Price In The Industry</div>\n      <div class=\"feature-desc\">\n        Ensuring Quality at competitive<br>\n        rates\n      </div>\n    </div>\n\n    <div class=\"feature-box\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/India.png\" alt=\"Pan India\" class=\"feature-icon\">\n      <div class=\"feature-title\">Pan India Network</div>\n      <div class=\"feature-desc\">\n        Countrywide dealer network,<br>\n        remote location deliveries\n      </div>\n    </div>\n\n    <div class=\"feature-box\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Customer_Support.png\" alt=\"Support\" class=\"feature-icon\">\n      <div class=\"feature-title\">Customer<br>Support</div>\n      <div class=\"feature-desc\">\n        Skilled and experienced team,<br>\n        quick action to technical concerns<br>\n        support\n      </div>\n    </div>\n\n  </div>\n</section>"
