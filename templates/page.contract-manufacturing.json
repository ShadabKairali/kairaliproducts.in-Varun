      "settings": {
        "custom_liquid": "<style>\n\n\n    .solutions-section {\n      background: url('https://cdn.shopify.com/s/files/1/0925/8998/1983/files/herbal-bg.jpg') center/cover no-repeat;\n      padding: 60px 20px;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 30px;\n      justify-content: center;\n    }\n\n    .left-box,\n    .right-box {\n      border-radius: 20px;\n      padding: 40px 30px;\n      box-sizing: border-box;\n    }\n\n    .left-box {\n      background: rgba(0, 0, 0, 0.75);\n      color: #fff;\n      flex: 1;\n\n    }\n\n    .left-box h2 {\n      font-family: \"Canto\";\n      font-size: 32px;\n      margin-bottom: 25px;\n      font-weight: 600;\n      line-height: 1.2;\n      position: relative;\n      display: inline-flex;\n      align-items: center;\n      gap: 12px;\n    }\n    \n     .left-box h2::before,\n .left-box h2::after {\n    content: \"\";\n    display: inline-block;\n    background-repeat: no-repeat;\n    background-position: center;\n    background-size: contain;\n    width: 50px;\n    height: 20px;\n  \n}\n\n.left-box h2::before {\n    background-image: url('https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Vector_1.svg');\n\n}\n\n.left-box h2::after {\n    background-image: url('https://cdn.shopify.com/s/files/1/0925/8998/1983/files/after-line.svg');\n}\n\n    .left-box ul {\n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n\n    .left-box ul li {\n      font-size: 16px;\n      margin-bottom: 15px;\n    }\n\n    .left-box ul li i {\n      color: #b8a44a;\n      margin-right: 10px;\n    }\n\n    .right-box {\n      background: #fff;\n      color: #000;\n      flex: 2;\n      min-width: 300px;\n      max-width: 800px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      box-shadow: 0 8px 16px rgba(0,0,0,0.1);\n    }\n\n    .columns {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 20px;\n    }\n\n    .column h4 {\n      font-size: 16px;\n      font-weight: 700;\n      margin-bottom: 15px;\n      color: #1e392a;\n    }\n\n    .column ul {\n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n\n    .column ul li {\n      font-size: 14px;\n      margin-bottom: 10px;\n    }\n\n    .column ul li i {\n      color: #7a711f;\n      margin-right: 8px;\n    }\n\n    .button-group {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 20px;\n      margin-top: 30px;\n      \n    }\n\n    .button-group a {\n      padding: 12px 24px;\n      background: #054100;\n      color: #fff;\n      text-decoration: none;\n      font-weight: bold;\n      border-radius: 6px;\n      transition: background 0.3s ease;\n    }\n\n    .button-group a:hover {\n      background: #0b6000;\n    }\n\n    /* Responsive */\n    @media (max-width: 1024px) {\n      .columns {\n        grid-template-columns: repeat(2, 1fr);\n      }\n    }\n\n    @media (max-width: 768px) {\n      .solutions-section {\n        flex-direction: column;\n        padding: 40px 15px;\n      }\n\n\n\n      .left-box,\n      .right-box {\n        max-width: 100%;\n      }\n    }\n\n    @media (max-width: 480px) {\n       .left-box  {\n        text-align: center;\n      }\n      .left-box h2 {\n        font-size: 26px;\n      }\n      \n      .right-box {\n        text-align: center;\n      }\n\n      .button-group {\n        flex-direction: column;\n      }\n\n      .button-group a {\n        width: 80%;\n        text-align: center;\n      }\n    }\n  </style>\n\n\n<section class=\"solutions-section\">\n  <!-- LEFT BOX -->\n  <div class=\"left-box\">\n    <h2>Get All Solutions for</h2>\n    <ul>\n      <li><i class=\"fas fa-check-square\"></i> Ayurvedic Third Party Manufacturing</li>\n      <li><i class=\"fas fa-check-square\"></i> Ayurvedic Products Private Labeling</li>\n      <li><i class=\"fas fa-check-square\"></i> Ayurveda Contract Manufacturing Services</li>\n    </ul>\n  </div>\n\n  <!-- RIGHT BOX -->\n  <div class=\"right-box\">\n    <div class=\"columns\">\n      <div class=\"column\">\n        <h4>Third Party</h4>\n        <ul>\n          <li><i class=\"fas fa-square\"></i> Our Products</li>\n          <li><i class=\"fas fa-square\"></i> Our Products</li>\n          <li><i class=\"fas fa-square\"></i> Your Packing</li>\n        </ul>\n      </div>\n      <div class=\"column\">\n        <h4>Third Party</h4>\n        <ul>\n          <li><i class=\"fas fa-square\"></i> Our Products</li>\n          <li><i class=\"fas fa-square\"></i> Your Products</li>\n          <li><i class=\"fas fa-square\"></i> Your Packing</li>\n        </ul>\n      </div>\n      <div class=\"column\">\n        <h4>Loan Licence</h4>\n        <ul>\n          <li><i class=\"fas fa-square\"></i> Your Products</li>\n          <li><i class=\"fas fa-square\"></i> Your Brand</li>\n          <li><i class=\"fas fa-square\"></i> Your Packing</li>\n        </ul>\n      </div>\n      <div class=\"column\">\n        <h4>Loan Licence</h4>\n        <ul>\n          <li><i class=\"fas fa-square\"></i> Your Concept</li>\n          <li><i class=\"fas fa-square\"></i> Our R&D</li>\n          <li><i class=\"fas fa-square\"></i> Your Brand</li>\n          <li><i class=\"fas fa-square\"></i> Your Packing</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"button-group\">\n      <a href=\"#\">Download Our Catalogue</a>\n      <a href=\"#\">Download Our Presentation</a>\n    </div>\n  </div>\n</section>"
