        "collapsible_tab_EpcCet": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Is Kairali ayurvedic products certified by any regulatory authority?",
            "content": "<p>Yes, Kairali is GMP Certified Ayurvedic Manufacturing Company, vegan friendly certified, cruelty-free certified, ISO 9001:2015, made safe certified etc.</p>",
