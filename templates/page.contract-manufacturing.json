12px;\n  text-align: center;\n  padding: 20px 15px;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.05);\n  transition: 0.3s ease;\n}\n.certificate-card:hover {\n  transform: translateY(-4px);\n}\n\n.circle-img {\n  width: 110px;\n  height: 110px;\n  border: 2px solid #d4d4a0;\n  border-radius: 50%;\n  margin: 0 auto 15px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.circle-img img {\n  max-width: 70%;\n  max-height: 70%;\n}\n.certificate-card p {\n  font-weight: 600;\n  font-size: 16px;\n  color: #1c1c1c;\n  margin: 0;\n}\n\n/* Slick arrows */\n.media-slider .slick-prev,\n.media-slider .slick-next {\n  background: #8c9c42;\n  color: white;\n  border-radius: 50%;\n  width: 36px;\n  height: 36px;\n  z-index: 9;\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.25);\n}\n.media-slider .slick-prev {\n  left: -20px;\n}\n.media-slider .slick-next {\n  right: -20px;\n}\n.media-slider .slick-prev:before,\n.media-slider .slick-next:before {\n  color: white;\n  font-size: 20px;\n  line-height: 1;\n}\n\n/* Mobile fix */\n@media (max-width: 768px) {\n  .certification-title {\n    font-size: 24px;\n  }\n  .media-slider {\n    padding: 0 10px;\n  }\n}\n</style>\n\n<!-- Slick Carousel -->\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css\" />\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css\" />\n<script src=\"https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js\"></script>\n\n<!-- Init Script -->\n<script>\n$(document).ready(function(){\n  $('.media-slider').slick({\n    infinite: true,\n    slidesToShow: 5,\n    slidesToScroll: 1,\n    arrows: true,\n    autoplay: true,\n    autoplaySpeed: 2500,\n    dots: false,\n    prevArrow: '