    "custom_liquid_wG9r6H": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"media pt-5\">\n  <div class=\"container\">\n    <div class=\"row\">\n      <div class=\"awards-heading-media pb-4 w-100 text-center\">\n        <h2 class=\"certification-title\">Our Certifications</h2>\n      </div>\n\n      <div class=\"media-slider\">\n        <!-- Certificate Cards -->\n        <div class=\"certificate-card\">\n          <div class=\"circle-img\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/WHOGMP.png\" alt=\"WHO-GMP Certified\" />\n          </div>\n          <p>WHO-GMP Certified</p>\n        </div>\n\n        <div class=\"certificate-card\">\n          <div class=\"circle-img\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/CE_0b58637f-be1e-4751-b4e8-276b943de7be.png\" alt=\"CE Certificate\" />\n          </div>\n          <p>CE Certificate</p>\n        </div>\n\n        <div class=\"certificate-card\">\n          <div class=\"circle-img\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Cruelyfree.png\" alt=\"Cruelty Free Certified\" />\n          </div>\n          <p>Cruelty Free Certified</p>\n        </div>\n\n        <div class=\"certificate-card\">\n          <div class=\"circle-img\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/FDA_f6438d8c-6daa-4f63-91dd-c6cb79e86ea9.png\" alt=\"FDA Approved\" />\n          </div>\n          <p>FDA Approved</p>\n        </div>\n\n        <div class=\"certificate-card\">\n          <div class=\"circle-img\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/Fssai_d2f5b613-d7cd-4af7-866f-7264eeb72b2a.png\" alt=\"FSSAI Certified\" />\n          </div>\n          <p>FSSAI Certified</p>\n        </div>\n\n        <div class=\"certificate-card\">\n          <div class=\"circle-img\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0925/8998/1983/files/iso_e3c6aa14-52aa-400d-8a59-ec19d56bcbef.png\"