        "collapsible_tab_nUF3WV": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "What kind of ayurvedic products do you manufacture?",
            "content": "<p>We manufacture tablets, powders, Thailams, Kashayams, Choornam, proprietary medicines & oils, single herbs, proprietary oils, herbal tea, cosmetics & sanitizer. </p>",
