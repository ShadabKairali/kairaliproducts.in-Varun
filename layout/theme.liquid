    // Initialize sliders after script loads
    swiperContainers.forEach(container => {
      const controls = container.closest('.shopify-section') || container.parentElement;

      new Swiper(container, {
        slidesPerView: 'auto',
        spaceBetween: 16,
        navigation: {
          nextEl: controls?.querySelector('.wt-slider__nav-next--featured'),
          prevEl: controls?.querySelector('.wt-slider__nav-prev--featured')
        },
        pagination: {
          el: controls?.querySelector('.wt-slider__pagination'),
          clickable: true
        }
      });
    });
  };
});
</script>  
    

  
<script src="{{ 'tiny-img-link-preloader.js' | asset_url }}" defer></script>

{% if request.page_type == 'product' %}
  {{ 'kairali-easysell-semantics.css' | asset_url | stylesheet_tag: preload: true }}
  <script src="{{ 'kairali-easysell-semantics.js' | asset_url }}" defer></script>
{% endif %}



</body>
