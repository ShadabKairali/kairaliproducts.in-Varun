  const swiperContainers = Array.from(document.querySelectorAll('.swiper-container')).filter(
    (container) => container.querySelector(':scope > .swiper-wrapper')
  );
  if (!swiperContainers.length) return;

  // Load Swiper only on pages that contain a real Swiper instance.
  const swiperScript = document.createElement('script');
  swiperScript.src = '{{ "swiper-bundle.min.js" | asset_url }}';
  swiperScript.defer = true;
