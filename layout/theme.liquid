<script>
  (() => {
    let clarityLoaded = false;

    function privacyAllows(privacy, methodName) {
      try {
        return typeof privacy?.[methodName] === 'function' && privacy[methodName]() === true;
      } catch (error) {
        return false;
      }
    }

    function loadClarity() {
      if (clarityLoaded) return;
      clarityLoaded = true;

      window.clarity = window.clarity || function () {
        (window.clarity.q = window.clarity.q || []).push(arguments);
      };
      const clarity = document.createElement('script');
      clarity.async = true;
      clarity.src = 'https://www.clarity.ms/tag/sf60nw6j1p';
      document.head.appendChild(clarity);
    }

    function syncClarityConsent() {
      const privacy = window.Shopify?.customerPrivacy;
      if (!privacy) return;

      const analyticsAllowed = privacyAllows(privacy, 'analyticsProcessingAllowed');
      const marketingAllowed = privacyAllows(privacy, 'marketingAllowed');

      if (analyticsAllowed) loadClarity();

      if (window.clarity) {
        window.clarity('consentv2', {
          analytics_Storage: analyticsAllowed ? 'granted' : 'denied',
          ad_Storage: marketingAllowed ? 'granted' : 'denied'
        });
      }
    }

    document.addEventListener('shopifyCustomerPrivacyApiLoaded', syncClarityConsent);
    document.addEventListener('visitorConsentCollected', syncClarityConsent);
    syncClarityConsent();
  })();
</script>

