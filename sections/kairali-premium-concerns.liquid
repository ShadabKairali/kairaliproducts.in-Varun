{{ 'kairali-homepage-r03.css' | asset_url | stylesheet_tag }}

<section id="shop-by-concern" class="kp-home-section kp-home-section--tinted" aria-labelledby="KpConcerns-{{ section.id }}">
  <div class="kp-home-section__inner">
    <header class="kp-section-intro">
      <p class="kp-eyebrow">Start with your need</p>
