<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{% if section.settings.enable_quick_add_button %}
  <script src="{{ 'variant-dropdown.js' | asset_url }}" defer="defer"></script>
{% endif %}

<script active-filters>
  var activeFilters = {
  {% for filter in collection.filters %}
    "{{ filter.label }}": {
      {% for active_filter in filter.active_values %}
        "{{ active_filter.label }}": "{{ active_filter.value }}"{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  }
</script>

        <div class="collection__sticky-header collection__sticky-header--{{ section.settings.toolbar_style }}">
          <div class="collection__subheader">
            <div class="collection__counter">
              <span id="ProductCount" class="count">
                {% if collection.results_count %}
                  {{ 'templates.search.results_with_count' | t: terms: collection.terms, count: collection.results_count }}
                {% elsif collection.products_count == collection.all_products_count %}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {% else %}
                  {{ 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
                {% endif %}
              </span>
            </div>
          </div>
        </div>
<div data-section-id="{{ section.id }}" class="{% if section.settings.full-width-enabled %}section--full{% endif %}">
  <collection-section
    class="collection{% if section.settings.filter_position == 'always' %} collection--with-aside{% endif %}"
    data-filter-position="{{ section.settings.filter_position }}"
  >
   
    <div class="collection__flex-layout">
      {% if section.settings.enable_filtering %}
        <aside class="collection__sidebar">
<div class="collection__filter-group">        
      <div class="collection__parent-title" onclick="openNav()" >Filter</div>
<div class="collection__parent-content" id="myNav" >
<div class="collection__filter-group">          
            {% assign current_collection_title = collection.title | downcase %}
        {% if current_collection_title == 'body care' %}
          {% assign menu_handle = 'main-menu' %}
        {% elsif current_collection_title == 'hair care' %}
          {% assign menu_handle = 'hair-care-menu' %}
        {% elsif current_collection_title == 'face care' %}
          {% assign menu_handle = 'face-care-menu' %}
        {% else %}
          {% assign menu_handle = 'main-menu' %}
        {% endif %}

        {% assign nav_menu = linklists[menu_handle] %}
        {% if nav_menu.links.size > 0 %}
          <div class="quick-links">
            <ul>
              {% for link in nav_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}



  
        </div>
        </div>
        </div>
        </aside>
      {% endif %}

      <section id="ProductGridContainer" class="collection__body">


        {% paginate collection.products by section.settings.products_per_page %}
          <div
            id="product-grid"
            data-id="{{ section.id }}"
            class="collection__grid"
            data-cols="{{ section.settings.columns_mobile }}"
            data-cols-desktop="{{ section.settings.columns_desktop }}"
          >
            {% for product in collection.products %}
              {% assign lazy_load = false %}
              {% if forloop.index > 3 %}
                {% assign lazy_load = true %}
              {% endif %}
              {% assign url = product.url %}
              {% assign alt = product.featured_image.alt | escape %}
              {% assign uri = product.handle | escape %}
              {% if product.images[1] %}
                {% assign image_hover = product.images[1] %}
              {% else %}
                {% assign image_hover = false %}
              {% endif %}

              <div
                class="collection__grid__item {% if settings.animations %}scroll-trigger animate--slide-in{% endif %} {% if settings.disabled_animations_on_mobile %}disabled-on-mobile{% endif %}"
                {% if settings.animations %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}
              >
                {% render 'card',
                  card_product: product,
                  img: product.featured_image,
                  image_ratio: section.settings.image_ratio,
                  img_hover: image_hover,
                  alt: alt,
                  subtitle: product.vendor,
                  reviews: product.metafields.reviews,
                  title: product.title,
                  url: url,
                  uri: uri,
                  variants: product.variants,
                  product_options: product.options,
                  product: product,
                  rating: section.settings.show_product_rating,
                  text_alignment: section.settings.text_alignment,
                  media_aspect_ratio: section.settings.image_ratio,
                  enable_quick_add_button: section.settings.enable_quick_add_button,
                  show_video: section.settings.show_video,
                  lazy_load: lazy_load
                %}
              </div>
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            {% render 'pagination', paginate: paginate, anchor: '' %}
          {% endif %}
        {% endpaginate %}
      </section>
    </div>
  </collection-section>
  {% if collection.products.size == 0 %}
    <div class="collection__counter collection__empty-collection">
      {{ 'sections.collection_template.empty' | t }}
    </div>
  {% endif %}
</div>

<style>
.collection__flex-layout {
  display: flex;
  gap: 24px;
  flex-wrap: nowrap;
}

.collection__sidebar {
  max-width: 260px;
  flex-shrink: 0;
  position: sticky;
  font-family: var(--font-base);
  width: 25%;
}

.collection__body {
  flex-grow: 1;
}

.quick-links {
  margin-bottom: 20px;
}

.quick-links ul {
  list-style: none;
  padding: 0;
  gap: 16px;
  flex-wrap: wrap;
}

.quick-links a {
    color: #333;
    text-decoration: none;
    font-weight: 500;
    display: block;
    padding: 6px 8px;
    border-radius: 4px;
    transition: all 0.3s;
  }

  .quick-links a:hover {
    background-color: #b8860b;
    color: #fff;
  }

.collection__parent-title {
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    margin-bottom: 10px;
    cursor: pointer;
    justify-content: space-between;
    align-items: center;
    letter-spacing: 0.18em;
    text-color: #1c1c1c;
  }  

  .collection__filter-group {
    margin-bottom: 20px;
  }

.count {
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    margin-bottom: 10px;
    justify-content: space-between;
    text-align: center;
    letter-spacing: 0.18em;
    text-color: #1c1c1c;
    margin-left: 50%;
  }  

  
@media (max-width: 899px) {
  .collection__flex-layout {
    flex-direction: column;
  }
  .collection__sidebar {
    width: 100%;
    position: sticky;
  }

  .collection__parent-title {
    display: none;
    position: sticky;
    top: 0;
 
  border: 2px solid #4CAF50;
  }
    
.collection__parent-content {
    display: none;
  }  
}

  @media (max-width: 899px) {
    .collection__grid {
      {% if section.settings.columns_mobile == "1" %}
        --cols: 1;
      {% else %}
        --cols: 2;
      {% endif %}
    }
  }
  
</style>

<script src="{{ 'collection-section.js' | asset_url }}" defer="defer"></script>

<script>
function openNav() {
  document.getElementById("myNav").style.width = "100%";
}

function closeNav() {
  document.getElementById("myNav").style.width = "0%";
}
</script>




{% schema %}
{
  "name": "flex collection section",
  "tag": "section",
  "class": "spaced-section collection-grid-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 120,
      "step": 12,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "spacing_desktop",
      "label": "Grid spacing (desktop)",
      "options": [
        { "value": "8", "label": "8px" },
        { "value": "16", "label": "16px" },
        { "value": "24", "label": "24px" }
      ],
      "default": "16"
    },
    {
      "type": "select",
      "id": "spacing_mobile",
      "label": "Grid spacing (mobile)",
      "options": [
        { "value": "4", "label": "4px" },
        { "value": "8", "label": "8px" },
        { "value": "12", "label": "12px" },
        { "value": "16", "label": "16px" }
      ],
      "default": "16"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_product_rating",
      "label": "Show product rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add_button",
      "label": "Enable quick add button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Enable product video",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full-width-enabled",
      "label": "Enable full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_position",
      "label": "Filter position",
      "options": [
        { "value": "always", "label": "Always visible" },
        { "value": "drawer", "label": "Drawer" }
      ],
      "default": "always"
    },
    {
      "type": "select",
      "id": "toolbar_style",
      "label": "Toolbar style",
      "options": [
        { "value": "minimal", "label": "Minimal" },
        { "value": "buttons", "label": "Buttons" }
      ],
      "default": "minimal"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Top margin"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px",
      "label": "Bottom margin"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
