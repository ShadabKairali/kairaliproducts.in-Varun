</div>

<script src="{{ 'collection-section.js' | asset_url }}" defer="defer"></script>

  <script>
function openNav() {
  document.getElementById("myNav").style.width = "100%";
}

function closeNav() {
  document.getElementById("myNav").style.width = "0%";
}
</script>

  
{% schema %}
{
  "name": "category himanshu",
  "tag": "section",
  "class": "spaced-section collection-grid-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 120,
      "step": 12,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "spacing_desktop",
      "label": "Grid spacing (desktop)",
      "options": [
        { "value": "8", "label": "8px" },
        { "value": "16", "label": "16px" },
        { "value": "24", "label": "24px" }
      ],
      "default": "16"
    },
    {
      "type": "select",
      "id": "spacing_mobile",
      "label": "Grid spacing (mobile)",
      "options": [
        { "value": "4", "label": "4px" },
        { "value": "8", "label": "8px" },
        { "value": "12", "label": "12px" },
        { "value": "16", "label": "16px" }
      ],
      "default": "16"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_product_rating",
      "label": "Show product rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add_button",
      "label": "Enable quick add button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Enable product video",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full-width-enabled",
      "label": "Enable full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_position",
      "label": "Filter position",
      "options": [
        { "value": "always", "label": "Always visible" },
        { "value": "drawer", "label": "Drawer" }
      ],
      "default": "always"
    },
    {
      "type": "select",
      "id": "toolbar_style",
      "label": "Toolbar style",
      "options": [
        { "value": "minimal", "label": "Minimal" },
        { "value": "buttons", "label": "Buttons" }
      ],
      "default": "minimal"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Top margin"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px",
      "label": "Bottom margin"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
