{%- liquid
  assign product_keys = 'product_1,product_2,product_3' | split: ','
  assign selected_card_count = 0

  for product_key in product_keys
    assign selected_product = section.settings[product_key]
    assign selected_variant = selected_product.selected_or_first_available_variant
    if selected_product != blank and selected_variant != blank
      assign selected_card_count = selected_card_count | plus: 1
    endif
  endfor
-%}

{%- if selected_card_count > 0 -%}
  <section
    class="kairali-larger-packs"
    data-larger-packs
    aria-labelledby="LargerPacksHeading-{{ section.id }}"
  >
    <div class="kairali-larger-packs__inner">
      <header class="kairali-larger-packs__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kairali-larger-packs__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="LargerPacksHeading-{{ section.id }}" class="kairali-larger-packs__heading">
          {{ section.settings.heading | escape }}
        </h2>
        {%- if section.settings.intro != blank -%}
          <p class="kairali-larger-packs__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>

      <div class="kairali-larger-packs__grid">
        {%- for product_key in product_keys -%}
          {%- liquid
            assign selected_product = section.settings[product_key]
            assign selected_variant = selected_product.selected_or_first_available_variant
            assign label_key = 'label_' | append: forloop.index
            assign pack_key = 'pack_' | append: forloop.index
            assign card_label = section.settings[label_key]
            assign pack_label = section.settings[pack_key]
          -%}

          {%- if selected_product != blank and selected_variant != blank -%}
            {%- capture product_link -%}{{ selected_product.url }}?variant={{ selected_variant.id }}{%- endcapture -%}
            <article class="kairali-larger-packs__card" data-larger-pack-card="{{ selected_product.handle | escape }}">
              <a
                class="kairali-larger-packs__media"
                href="{{ product_link }}"
                aria-label="View {{ card_label | default: selected_product.title | escape }}, {{ pack_label | escape }}"
              >
                {%- if selected_product.featured_image != blank -%}
                  {{-
                    selected_product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 900',
                      sizes: '(min-width: 990px) 30vw, (min-width: 640px) 46vw, 92vw',
                      alt: card_label,
                      class: 'kairali-larger-packs__image'
                  -}}
                {%- endif -%}
              </a>

              <div class="kairali-larger-packs__content">
                {%- if pack_label != blank -%}
                  <p class="kairali-larger-packs__pack">{{ pack_label | escape }}</p>
                {%- endif -%}
                <h3 class="kairali-larger-packs__title">
                  <a href="{{ product_link }}">{{ card_label | default: selected_product.title | escape }}</a>
                </h3>
                <p class="kairali-larger-packs__price">
                  <span class="visually-hidden">Current online price:</span>
                  {{ selected_variant.price | money }}
                </p>
                <a class="kairali-larger-packs__link" href="{{ product_link }}">
                  View product
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .kairali-larger-packs {
    margin: 24px 0;
    position: relative;
    overflow: hidden;
    background-color: #f4f0e7;
    color: #18382d;
    border-block: 1px solid rgba(193, 136, 44, 0.24);
  }

  .section-kairali-larger-packs .kairali-larger-packs {
    margin: 24px 0;
    position: relative;
    overflow: hidden;
    background-color: #f4f0e7;
    color: #18382d;
    border-block: 1px solid rgba(193, 136, 44, 0.24);
  }

  .kairali-larger-packs::before {
    content: none;
  }

  .kairali-larger-packs::after {
    content: none;
  }

  .kairali-larger-packs__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: clamp(36px, 5vw, 72px) clamp(18px, 4vw, 56px);
  }

  .kairali-larger-packs__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 520px);
    column-gap: 40px;
    align-items: end;
    margin-bottom: 28px;
  }

  .kairali-larger-packs__eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 10px;
    color: #69753a;
    font-size: 12px;
    font-family: var(--font-base);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .kairali-larger-packs__heading {
    margin: 0;
    color: inherit;
    font-family: var(--font-headline);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .kairali-larger-packs__intro {
    margin: 0;
    color: #4d5d55;
    font-family: var(--font-base);
    font-size: 17px;
    line-height: 1.6;
  }

  .kairali-larger-packs__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 26px);
  }

  .kairali-larger-packs__card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #d9d1c2;
    border-radius: 4px;
    background: #fffdf9;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .kairali-larger-packs__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(25, 56, 45, 0.09);
  }

  .kairali-larger-packs__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f9f7f1;
  }

  .kairali-larger-packs__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(12px, 2vw, 28px);
    transition: transform 240ms ease;
  }

  .kairali-larger-packs__card:hover .kairali-larger-packs__image {
    transform: scale(1.018);
  }

  .kairali-larger-packs__content {
    padding: 20px 22px 24px;
  }

  .kairali-larger-packs__pack {
    display: inline-flex;
    margin: 0 0 12px;
    padding: 5px 9px;
    border: 1px solid #cbd2ae;
    border-radius: 2px;
    color: #55612d;
    font-family: var(--font-base);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
  }

  .kairali-larger-packs__title {
    margin: 0;
    font-family: var(--font-base);
    font-size: clamp(19px, 1.35vw, 22px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .kairali-larger-packs__title a,
  .kairali-larger-packs__link {
    color: inherit;
    text-decoration: none;
  }

  .kairali-larger-packs__price {
    margin: 14px 0 18px;
    color: #33483f;
    font-family: var(--font-price);
    font-size: 16px;
    font-weight: 600;
  }

  .kairali-larger-packs__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-button);
    font-size: 14px;
    font-weight: 600;
  }

  .kairali-larger-packs__link span {
    transition: transform 180ms ease;
  }

  .kairali-larger-packs__link:hover span,
  .kairali-larger-packs__link:focus-visible span {
    transform: translateX(3px);
  }

  .kairali-larger-packs__media:focus-visible,
  .kairali-larger-packs__title a:focus-visible,
  .kairali-larger-packs__link:focus-visible {
    outline: 2px solid #18382d;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .kairali-larger-packs {
      margin: 16px 0;
    }

    .kairali-larger-packs__inner {
      padding: 34px 16px 40px;
    }

    .kairali-larger-packs__header {
      display: block;
      margin-bottom: 22px;
    }

    .kairali-larger-packs__heading {
      font-size: clamp(30px, 8.7vw, 38px);
      line-height: 1.08;
    }

    .kairali-larger-packs__intro {
      margin-top: 14px;
    }

    .kairali-larger-packs__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .kairali-larger-packs__card {
      display: grid;
      grid-template-columns: minmax(118px, 40%) minmax(0, 1fr);
    }

    .kairali-larger-packs__media {
      height: 100%;
      min-height: 188px;
      aspect-ratio: auto;
    }

    .kairali-larger-packs__content {
      align-self: center;
      padding: 18px 16px 20px;
    }

    .kairali-larger-packs__title {
      font-size: 19px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kairali-larger-packs__card,
    .kairali-larger-packs__image,
    .kairali-larger-packs__link span {
      transition: none;
    }
  }
{% endstylesheet %}

