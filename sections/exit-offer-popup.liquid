{%- liquid
  assign offer_code = section.settings.discount_code | strip | upcase
  assign support_url = section.settings.support_url

  if support_url == blank
    assign support_url = '/pages/contact-us'
  endif
-%}

{{ 'exit-offer-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'exit-offer-popup.js' | asset_url }}" defer="defer"></script>

<exit-offer-popup
  class="kairali-exit-offer"
  data-enabled="{{ section.settings.enabled }}"
  data-store="{{ shop.permanent_domain | escape }}"
  data-dismiss-days="{{ section.settings.dismiss_days }}"
  data-converted-days="{{ section.settings.converted_days }}"
  data-mobile-delay="{{ section.settings.mobile_delay }}"
  data-mobile-scroll="{{ section.settings.mobile_scroll }}"
  hidden
>
  <dialog class="kairali-exit-offer__dialog" aria-labelledby="ExitOfferTitle-{{ section.id }}">
    <button class="kairali-exit-offer__close" type="button" aria-label="Close offer" data-exit-offer-close>
      <span aria-hidden="true">&times;</span>
    </button>

    <div class="kairali-exit-offer__visual">
      <img
        class="kairali-exit-offer__scene"
        src="{{ 'kairali-exit-offer-scene.webp' | asset_url }}"
        alt=""
        width="1200"
        height="800"
      >
      <div class="kairali-exit-offer__brand-card">
        <img
          class="kairali-exit-offer__logo"
          src="{{ 'kairali-exit-offer-logo.svg' | asset_url }}"
          alt="Kairali Ayurvedic Products"
          width="304"
          height="276"
        >
      </div>
      <p class="kairali-exit-offer__heritage">Ayurveda since 1908</p>
    </div>

    <div class="kairali-exit-offer__content">
      {%- form 'customer', id: 'KairaliExitOfferForm', class: 'kairali-exit-offer__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,exit-offer">

        {%- if form.posted_successfully? -%}
          <div class="kairali-exit-offer__success" data-exit-offer-success>
            <p class="kairali-exit-offer__eyebrow">Your welcome offer</p>
            <h2 id="ExitOfferTitle-{{ section.id }}">{{ section.settings.success_heading | escape }}</h2>
            <p>{{ section.settings.success_text | escape }}</p>
            <div class="kairali-exit-offer__code-row">
              <strong data-exit-offer-code>{{ offer_code | escape }}</strong>
              <button type="button" data-exit-offer-copy>Copy code</button>
            </div>
            <a
              class="kairali-exit-offer__primary"
              href="/discount/{{ offer_code | url_encode }}?redirect={{ routes.all_products_collection_url | url_encode }}"
              data-exit-offer-shop
            >Shop with 5% off</a>
          </div>
        {%- else -%}
          <div data-exit-offer-entry>
            <p class="kairali-exit-offer__eyebrow">A small welcome from Kairali</p>
            <h2 id="ExitOfferTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
            <p>{{ section.settings.body | escape }}</p>

            {%- if form.errors -%}
              <div class="kairali-exit-offer__error" role="alert">Please check your email and try again.</div>
            {%- endif -%}

            <label class="kairali-exit-offer__label" for="ExitOfferEmail-{{ section.id }}">Email address</label>
            <input
              id="ExitOfferEmail-{{ section.id }}"
              class="kairali-exit-offer__email"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              inputmode="email"
              required
            >

            <label class="kairali-exit-offer__consent">
              <input type="checkbox" name="contact[accepts_marketing]" value="true" required>
              <span>Email me this code and occasional Kairali offers. I can unsubscribe at any time.</span>
            </label>

            <button class="kairali-exit-offer__primary" type="submit" data-exit-offer-submit>
              {{ section.settings.button_label | escape }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}

      <a class="kairali-exit-offer__support" href="{{ support_url }}" data-exit-offer-support>
        Need help choosing? Ask Kairali
      </a>
      <p class="kairali-exit-offer__fine-print">One use per customer. Other discount terms may apply.</p>
    </div>
  </dialog>
</exit-offer-popup>

{% schema %}
{
  "name": "Exit offer popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable exit offer",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you go — enjoy 5% off"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Enter your email and we’ll reveal your welcome code instantly."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Reveal my 5% code"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "default": "SAVE5"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading",
      "default": "Your 5% code is ready"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Copy the code below and use it at checkout."
    },
    {
      "type": "url",
      "id": "support_url",
      "label": "Help or enquiry link"
    },
    {
      "type": "range",
      "id": "dismiss_days",
      "label": "Days before showing again after dismissal",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 7
    },
    {
      "type": "range",
      "id": "converted_days",
      "label": "Days suppressed after signup",
      "min": 7,
      "max": 90,
      "step": 1,
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_delay",
      "label": "Mobile delay (seconds)",
      "min": 20,
      "max": 90,
      "step": 5,
      "default": 45
    },
    {
      "type": "range",
      "id": "mobile_scroll",
      "label": "Mobile scroll threshold",
      "min": 40,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 65
    }
  ]
}
{% endschema %}
