{%- liquid
  if section.settings.market_style == 'global'
    assign desktop_asset = 'kairali-home-hero-global-desktop-v2.jpg'
    assign mobile_asset = 'kairali-home-hero-global-mobile-v2.jpg'
    assign mobile_width = 1003
    assign mobile_height = 1568
  else
    assign desktop_asset = 'kairali-home-hero-india-desktop-v2.jpg'
    assign mobile_asset = 'kairali-home-hero-india-mobile-v2.jpg'
    assign mobile_width = 1122
    assign mobile_height = 1402
  endif
-%}

<section
  class="kairali-premium-hero kairali-premium-hero--{{ section.settings.market_style }}"
  aria-labelledby="KairaliHeroHeading-{{ section.id }}"
>
  <picture class="kairali-premium-hero__background" aria-hidden="true">
    <source
      media="(max-width: 749px)"
      srcset="{{ mobile_asset | asset_url }}"
      width="{{ mobile_width }}"
      height="{{ mobile_height }}"
    >
    <img
      src="{{ desktop_asset | asset_url }}"
      alt=""
      width="1672"
      height="941"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
  </picture>

  <div class="kairali-premium-hero__scrim" aria-hidden="true"></div>
  <div class="kairali-premium-hero__watermark" aria-hidden="true">1908</div>

  <div class="kairali-premium-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="kairali-premium-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <span class="kairali-premium-hero__ritual" aria-hidden="true"><span></span><b>✳</b><span></span></span>
    {%- endif -%}

    <h1 id="KairaliHeroHeading-{{ section.id }}" class="kairali-premium-hero__heading">
      {{ section.settings.heading | escape }}
    </h1>

    {%- if section.settings.lead != blank -%}
      <p class="kairali-premium-hero__lead">{{ section.settings.lead | escape }}</p>
    {%- endif -%}

    <div class="kairali-premium-hero__actions">
      {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
        <a class="kairali-premium-hero__button kairali-premium-hero__button--primary" href="{{ section.settings.primary_link }}">
          {{ section.settings.primary_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
        <a class="kairali-premium-hero__button kairali-premium-hero__button--secondary" href="{{ section.settings.secondary_link }}">
          {{ section.settings.secondary_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.confidence_line != blank -%}
      <p class="kairali-premium-hero__confidence">{{ section.settings.confidence_line | escape }}</p>
    {%- endif -%}
  </div>

</section>

{%- style -%}
  {%- if section.settings.market_style == 'india' -%}
    #shopify-section-{{ section.id }} {
      margin-top: -72px;
    }

    @media (min-width: 1200px) {
      #shopify-section-{{ section.id }} {
        margin-top: -98px;
      }
    }

    .wt-header.wt-header--transparent .wt-header__nav-teaser__link,
    .wt-header.wt-header--transparent .wt-page-nav-mega__link,
    .wt-header.wt-header--transparent .wt-header__menu-trigger,
    .wt-header.wt-header--transparent .wt-header__button {
      color: #fbfaf6 !important;
    }

    body.template-index.dropdown-open-desk .wt-header.wt-header--transparent .wt-page-nav-mega__link[data-menu-level="1"],
    body.template-index .wt-header.wt-header--transparent .wt-page-nav-mega__link[data-menu-level="1"]:hover,
    body.template-index .wt-header.wt-header--transparent .wt-page-nav-mega__link[data-menu-level="1"]:focus {
      color: #59651a !important;
    }

    @media (min-width: 1200px) {
      body.template-index.dropdown-open-desk .wt-header.wt-header--transparent {
        background-color: #fbfaf6 !important;
        transition: none !important;
      }

      body.template-index.dropdown-open-desk .wt-header.wt-header--transparent .wt-page-nav-mega__link[data-menu-level="1"],
      body.template-index.dropdown-open-desk .wt-header.wt-header--transparent .wt-header__nav-teaser__link,
      body.template-index.dropdown-open-desk .wt-header.wt-header--transparent .wt-header__menu-trigger,
      body.template-index.dropdown-open-desk .wt-header.wt-header--transparent .wt-header__panel__link,
      body.template-index.dropdown-open-desk .wt-header.wt-header--transparent .wt-header__button {
        color: #59651a !important;
      }
    }
  {%- else -%}
    x-header.header a:not(.header__logo),
    x-header.header button,
    x-header.header summary {
      color: #59651a;
    }

    body.template-index x-header.header a:not(.header__logo):hover,
    body.template-index x-header.header a:not(.header__logo):focus,
    body.template-index x-header.header button:hover,
    body.template-index x-header.header button:focus,
    body.template-index x-header.header summary:hover,
    body.template-index x-header.header summary:focus {
      color: #59651a !important;
    }

    html body.template-index x-header.header.header.color-scheme .header__primary-nav .header__primary-nav-item > :is(a, summary):is(:hover, :focus) {
      color: #59651a !important;
    }

    :is(#kairali-header-contrast, x-header.header) .header__primary-nav .header__primary-nav-item > :is(a, summary).h6:is(:hover, :focus) {
      color: #59651a !important;
    }

    :is(#kairali-header-contrast, x-header.header) .header__primary-nav .h6:is(:hover, :focus) {
      color: #59651a !important;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .kairali-premium-hero {
    --hero-ivory: #f7f4ea;
    --hero-ink: #2a2118;
    --hero-forest: #006038;
    --hero-bronze: #c1882c;
    --hero-marigold: #eeb41e;
    position: relative;
    min-height: clamp(620px, 47vw, 820px);
    overflow: hidden;
    isolation: isolate;
    background: #0a1a11;
    color: var(--hero-ivory);
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__background,
  #shopify-section-{{ section.id }} .kairali-premium-hero__background img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__background img {
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(4, 12, 8, 0.9) 0%, rgba(4, 12, 8, 0.62) 24%, rgba(4, 12, 8, 0.18) 52%, rgba(4, 12, 8, 0.08) 100%),
      linear-gradient(90deg, rgba(4, 14, 9, 0.88) 0%, rgba(4, 14, 9, 0.8) 48%, rgba(4, 14, 9, 0.3) 62%, rgba(4, 14, 9, 0) 74%);
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__watermark {
    position: absolute;
    top: clamp(92px, 8vw, 138px);
    right: -0.04em;
    z-index: 2;
    color: rgba(247, 244, 234, 0.065);
    font-family: var(--font-headline);
    font-size: clamp(150px, 24vw, 390px);
    font-weight: 400;
    letter-spacing: -0.08em;
    line-height: 0.72;
    pointer-events: none;
    user-select: none;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__content {
    position: relative;
    z-index: 3;
    display: flex;
    min-height: inherit;
    width: min(62%, 820px);
    padding: clamp(150px, 13vw, 220px) 4.5vw 80px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__eyebrow {
    margin: 0 0 16px;
    color: var(--hero-bronze);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.2em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__ritual {
    display: grid;
    width: min(220px, 62vw);
    margin: 0 0 22px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    color: var(--hero-bronze);
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__ritual span {
    height: 1px;
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__ritual b {
    font-size: 13px;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__heading {
    max-width: 12ch;
    margin: 0;
    color: var(--hero-ivory);
    font-size: clamp(42px, 4.4vw, 70px);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__lead {
    max-width: 54ch;
    margin: 24px 0 0;
    padding-left: 18px;
    border-left: 3px solid var(--hero-bronze);
    color: rgba(251, 246, 234, 0.88);
    font-size: clamp(16px, 1.2vw, 19px);
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__button {
    display: inline-flex;
    min-height: 52px;
    padding: 13px 22px;
    border: 1px solid var(--hero-ivory);
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    color: var(--hero-ivory);
    font-size: 14px;
    font-weight: 650;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__button--primary {
    border-color: var(--hero-marigold);
    background: var(--hero-marigold);
    color: var(--hero-ink);
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__button:hover,
  #shopify-section-{{ section.id }} .kairali-premium-hero__button:focus-visible {
    border-color: var(--hero-marigold);
    background: var(--hero-marigold);
    color: var(--hero-ink);
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__button:focus-visible {
    outline: 3px solid #6b7726;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px rgba(247, 244, 234, 0.94);
  }

  #shopify-section-{{ section.id }} .kairali-premium-hero__confidence {
    margin: 24px 0 0;
    color: rgba(251, 246, 234, 0.92);
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .kairali-premium-hero {
      min-height: 760px;
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__content {
      width: 72%;
      padding-inline: 32px;
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .kairali-premium-hero {
      min-height: min(880px, 178vw);
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__background img {
      object-position: center;
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__scrim {
      background:
        linear-gradient(180deg, rgba(3, 10, 7, 0.94) 0%, rgba(3, 10, 7, 0.86) 62%, rgba(3, 10, 7, 0.56) 80%, rgba(3, 10, 7, 0.66) 100%),
        linear-gradient(90deg, rgba(3, 10, 7, 0.48) 0%, rgba(3, 10, 7, 0.08) 92%);
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__content {
      width: 100%;
      min-height: auto;
      padding: 132px 22px 110px;
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__eyebrow {
      margin-bottom: 12px;
      font-size: 11px;
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__ritual {
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__watermark {
      top: 108px;
      right: -0.08em;
      font-size: clamp(122px, 48vw, 190px);
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__heading {
      max-width: 13ch;
      font-size: clamp(36px, 10vw, 48px);
      line-height: 1.02;
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__lead {
      max-width: 36ch;
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.48;
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__actions {
      gap: 10px;
      margin-top: 22px;
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__button {
      min-height: 46px;
      padding: 12px 16px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .kairali-premium-hero__confidence {
      max-width: 38ch;
      margin-top: 18px;
      font-size: 11px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .kairali-premium-hero__button {
      transition: none;
    }
  }
{%- endstyle -%}

<script>
  (() => {
    const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
    const hero = sectionRoot?.querySelector('.kairali-premium-hero');
    const transparentHeader = document.querySelector('.wt-header[data-transparent="true"]');

    if (!sectionRoot || !hero || !transparentHeader) return;

    transparentHeader.querySelector('.wt-header__logo')?.classList.add('wt-header__logo--show');

    const intersectionObserver = new IntersectionObserver(
      ([entry]) => {
        transparentHeader.classList.toggle('wt-header--transparent', entry.isIntersecting);
      },
      { threshold: 0.05 }
    );
    intersectionObserver.observe(hero);

  })();
</script>

{% schema %}
{
  "name": "Kairali premium hero",
  "tag": "section",
  "class": "section-kairali-premium-hero",
  "settings": [
    {
      "type": "select",
      "id": "market_style",
      "label": "Market art direction",
      "options": [
        { "value": "india", "label": "India" },
        { "value": "global", "label": "Global" }
      ],
      "default": "india"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ayurveda, made practical" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Daily care rooted in Ayurvedic tradition" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Explore product formats with clear pack information and guidance before you order." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Explore the range" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Find guidance" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "confidence_line", "label": "Confidence line" }
  ],
  "presets": [
    { "name": "Kairali premium hero" }
  ]
}
{% endschema %}
