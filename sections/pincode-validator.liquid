{% comment %}
  Section: Pincode Validator (Block based)
  Requires asset: assets/pincodes.json

  JSON format:
  {
    "serviceable": ["110001", "400001"],
    "cod_unavailable": ["682001"]
  }
{% endcomment %}

<style>
.kp-pincode-section {
  box-sizing: border-box;
  margin: 0;
  padding-inline: clamp(16px, 4vw, 64px);
  width: 100%;
}

.kp-pincode-checker {
  box-sizing: border-box;
  margin-inline: auto;
  width: 100%;
}

.kp-pincode-fields {
  display: flex;
  gap: 8px;
  min-width: 0;
}

.kp-pincode-input {
  min-width: 0;
}

.kp-pincode-input,
.kp-pincode-btn {
  min-height: 44px;
}

@media (max-width: 480px) {
  .kp-pincode-fields {
    align-items: stretch;
    flex-direction: column;
  }

  .kp-pincode-btn {
    width: 100%;
  }
}
</style>

<section class="kp-pincode-section" style="padding-block: {{ section.settings.section_padding }}px;">
  {% for block in section.blocks %}
    {% if block.type == 'pincode_validator' %}
      <div
        class="kp-pincode-checker"
        id="kpPincodeChecker-{{ section.id }}-{{ block.id }}"
        data-pincode-asset-url="{{ 'pincodes.json' | asset_url }}"
        style="max-width: {{ block.settings.max_width }}px; margin: 0 auto 16px;"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.heading != blank %}
          <h3 style="margin-bottom:6px;">{{ block.settings.heading }}</h3>
        {% endif %}

        {% if block.settings.subtext != blank %}
          <div style="font-size:14px; opacity:0.85; margin-bottom:8px;">
            {{ block.settings.subtext }}
          </div>
        {% endif %}

        <form class="kp-pincode-form" novalidate>
        <div class="kp-pincode-fields">
          <label
            class="visually-hidden"
            for="kpPincodeInput-{{ section.id }}-{{ block.id }}"
          >
            Delivery pincode
          </label>
          <input
            id="kpPincodeInput-{{ section.id }}-{{ block.id }}"
            class="kp-pincode-input"
            type="text"
            name="pincode"
            inputmode="numeric"
            autocomplete="postal-code"
            enterkeyhint="done"
            pattern="[0-9]{6}"
            maxlength="6"
            placeholder="{{ block.settings.placeholder }}"
            aria-describedby="kpPincodeMessage-{{ section.id }}-{{ block.id }}"
            style="flex:1; padding:10px; border:1px solid #ddd; border-radius:6px;"
          />
          <button
            class="kp-pincode-btn"
            type="submit"
            style="padding:10px 14px; background:#111; color:#fff; border:0; border-radius:6px; cursor:pointer;"
          >
            {{ block.settings.button_text }}
          </button>
        </div>
        </form>

        <div
          id="kpPincodeMessage-{{ section.id }}-{{ block.id }}"
          class="kp-pincode-msg"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          style="margin-top:10px; font-size:14px;"
        ></div>
      </div>
    {% endif %}
  {% endfor %}

</section>

<script>
(function () {
  window.__KP_PINCODE_CACHE__ = window.__KP_PINCODE_CACHE__ || null;

  function normalize(v) {
    return (v || '').replace(/\D/g,'').slice(0,6);
  }

  async function loadPincodes(url) {
    if (window.__KP_PINCODE_CACHE__) return window.__KP_PINCODE_CACHE__;

    const res = await fetch(url, { cache: 'force-cache' });
    const json = await res.json();

    window.__KP_PINCODE_CACHE__ = {
      serviceable: new Set((json.serviceable || []).map(String)),
      codBlocked: new Set((json.cod_unavailable || []).map(String))
    };
    return window.__KP_PINCODE_CACHE__;
  }

  document.querySelectorAll('.kp-pincode-checker').forEach(function (root) {
    const input = root.querySelector('.kp-pincode-input');
    const btn = root.querySelector('.kp-pincode-btn');
    const msg = root.querySelector('.kp-pincode-msg');
    const form = root.querySelector('.kp-pincode-form');
    const assetUrl = root.dataset.pincodeAssetUrl;

    if (!input || !btn || !msg || !form || !assetUrl) return;

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      const pin = normalize(input.value);
      input.value = pin;

      if (pin.length !== 6) {
        msg.textContent = 'Please enter a valid 6-digit pincode.';
        msg.style.color = '#b00020';
        return;
      }

      msg.textContent = 'Checking availability...';
      msg.style.color = '#333';

      try {
        const data = await loadPincodes(assetUrl);

        if (data.codBlocked.has(pin)) {
          msg.textContent = 'Delivery is available with prepaid payment only. Cash on delivery is unavailable for this pincode.';
          msg.style.color = '#7a4b00';
          return;
        }

        if (data.serviceable.has(pin)) {
          msg.textContent = 'Delivery is available. Cash on delivery is available.';
          msg.style.color = '#0b5a2a';
          return;
        }

        msg.textContent = 'We are unable to confirm delivery to this pincode online. Please contact support before ordering.';
        msg.style.color = '#b00020';
      } catch (e) {
        msg.textContent = 'We are unable to confirm delivery to this pincode online. Please contact support before ordering.';
        msg.style.color = '#b00020';
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Pincode Validator Section",
  "settings": [
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section vertical padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "pincode_validator",
      "name": "Pincode Validator",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Check delivery availability"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext",
          "default": "<p>Enter your pincode to check ETA & COD availability.</p>"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Input placeholder",
          "default": "Enter 6-digit pincode"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Check"
        },
        {
          "type": "range",
          "id": "max_width",
          "label": "Max width (px)",
          "min": 260,
          "max": 800,
          "step": 20,
          "default": 520
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pincode Validator (Block Based)"
    }
  ]
}
{% endschema %}
