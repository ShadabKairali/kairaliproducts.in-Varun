{% if template == 'index' %}

  {% assign background_rgb = section.settings['color-overlay'] | color_to_rgb %}
  {% assign text_container_rgb = section.settings['text-container-color'] | color_to_rgb %}
  {% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}

  <!-- Swiper CDN (ensures autoplay works) -->
  {{ 'swiper-bundle.min.css' | asset_url | preload_tag: as: 'style' }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

  <style>
    section[id="shopify-section-{{ section.id }}"] {
      {% if background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-overlay-rgb: {{ background_rgb | remove: 'rgb(' | remove: ')' }};
        --color-overlay-opacity: 1;
      {% else %}
        --color-overlay-opacity: 0;
      {% endif %}

      {% if text_container_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --text-container-color: {{ text_container_rgb | remove: 'rgb(' | remove: ')' }};
        --text-container-opacity: {{ section.settings.color-overlay-opacity | divided_by: 100.0 }};
      {% else %}
        --text-container-opacity: 0;
      {% endif %}

      {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.color-body-text }};
      {% endif %}
    }




.page-header-image-banner,
    .wt-image-banner,
    .swipe-homepage-banner,
    .swiper--homepage-banner,
    .swiper-slide--homepage-banner {
      width: 100vw;
      max-width: 100% !important;
      margin: 0 auto;
      padding: 0;
      position: relative;
      top: 0;
      aspect-ratio: 16 / 6.5;
    }

    .swiper-slide--homepage-banner {
      
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    
.swiper-slide--homepage-banner picture,
    .swiper-slide--homepage-banner img {
      width: 100vw;
      max-width: 100vw;
      height: auto;
      object-fit: cover;
      
    }

    .homepage-banner-link {
      display: block;
      width: 100%;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }

    .slide-art-stage {
      display: block;
      width: 100%;
      height: 100%;
    }

    .slide-content {
      position: absolute;
      top: 50%;
      left: clamp(28px, 7.5vw, 124px);
      z-index: 2;
      width: min(43vw, 590px);
      max-width: 590px;
      margin: 0;
      padding: 0;
      text-align: left;
      transform: translateY(-50%);
    }

    .slide-content--position-right {
      right: clamp(28px, 7.5vw, 124px);
      left: auto;
    }

    .slide-content--dark { color: #17351f; }
    .slide-content--light {
      color: #f7f4ea;
      text-shadow: 0 2px 20px rgba(0, 0, 0, 0.34);
    }

    .slide-content__eyebrow {
      margin: 0 0 10px;
      color: #a66b16;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.18em;
      line-height: 1.35;
      text-transform: uppercase;
    }

    .slide-content--light .slide-content__eyebrow { color: #d8aa58; }

    .slide-content__heading {
      max-width: 14ch;
      margin: 0;
      font-family: var(--font-headline, var(--font-heading-family));
      font-size: clamp(34px, 3.25vw, 56px);
      font-weight: 520;
      letter-spacing: -0.035em;
      line-height: 1.02;
      text-wrap: balance;
    }

    .slide-content__lead {
      max-width: 46ch;
      margin: 15px 0 0;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.5;
    }

    .slide-content__offer {
      display: flex;
      min-height: 30px;
      margin-top: 14px;
      align-items: baseline;
      gap: 10px;
      line-height: 1.1;
    }

    .slide-content__price {
      font-family: var(--font-headline, var(--font-heading-family));
      font-size: clamp(22px, 1.8vw, 30px);
      font-weight: 600;
    }

    .slide-content__compare-at {
      font-size: 14px;
      opacity: 0.68;
      text-decoration: line-through;
    }

    .slide-content__badge {
      color: #a66b16;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .slide-content--light .slide-content__badge { color: #d8aa58; }

    .slide-content__cta {
      display: inline-flex;
      box-sizing: border-box;
      width: max-content;
      max-width: 100%;
      min-height: 44px;
      margin-top: 20px;
      padding: 9px 16px;
      border: 1px solid currentColor;
      border-radius: 2px;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.09em;
      line-height: 1;
      white-space: nowrap;
      text-transform: uppercase;
    }

    .homepage-banner-link:hover .slide-content__cta,
    .homepage-banner-link:focus-visible .slide-content__cta {
      border-color: #d7a23f;
      background: #d7a23f;
      color: #17351f;
      text-shadow: none;
    }

    .homepage-banner-link:focus-visible {
      outline: 3px solid #fff;
      outline-offset: -5px;
    }

    .swiper-slide--heritage {
      --hero-ivory: #f7f4ea;
      --hero-ink: #2a2118;
      --hero-bronze: #c1882c;
      --hero-marigold: #eeb41e;
      color: var(--hero-ivory);
      background: #0a1a11;
    }

    .heritage-slide__background,
    .heritage-slide__background img,
    .heritage-slide__scrim {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .heritage-slide__background img {
      object-fit: cover;
    }

    .heritage-slide__scrim {
      z-index: 1;
      background:
        repeating-linear-gradient(0deg, rgba(247, 244, 234, 0.026) 0 1px, transparent 1px 5px),
        linear-gradient(180deg, rgba(4, 12, 8, 0.7), rgba(4, 12, 8, 0.12)),
        linear-gradient(90deg, rgba(4, 14, 9, 0.9) 0%, rgba(4, 14, 9, 0.78) 46%, rgba(4, 14, 9, 0.22) 68%, transparent 82%);
    }

    .heritage-slide__products {
      position: absolute;
      right: 2%;
      bottom: 0;
      z-index: auto;
      width: min(50vw, 780px);
      height: 92%;
      pointer-events: none;
    }

    .heritage-slide__products::before {
      content: "";
      position: absolute;
      left: 25%;
      bottom: 7%;
      z-index: 1;
      width: 58%;
      height: 72%;
      background: radial-gradient(ellipse at center, rgba(246, 221, 160, 0.82) 0%, rgba(190, 137, 48, 0.42) 42%, transparent 73%);
      filter: blur(14px);
    }

    .swiper--homepage-banner .heritage-slide__product {
      position: absolute;
      bottom: -2%;
      width: 46%;
      max-width: none;
      height: auto;
      object-fit: contain;
      object-position: center bottom;
      filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.34));
    }

    .swiper--homepage-banner .heritage-slide__product--kairoil {
      left: 0;
      z-index: 2;
      width: 45%;
    }

    .swiper--homepage-banner .heritage-slide__product--kaircin {
      left: 27%;
      z-index: 3;
      width: 52%;
      mix-blend-mode: normal;
      filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.34));
    }

    .swiper--homepage-banner .heritage-slide__product--kairkare {
      right: -2%;
      z-index: 2;
      width: 46%;
    }

    .heritage-slide__watermark {
      position: absolute;
      top: 12%;
      right: -0.03em;
      z-index: 2;
      color: rgba(247, 244, 234, 0.14);
      font-family: var(--font-headline);
      font-size: clamp(130px, 22vw, 360px);
      letter-spacing: -0.08em;
      line-height: 0.72;
      pointer-events: none;
    }

    .heritage-slide__content {
      position: relative;
      z-index: 4;
      box-sizing: border-box;
      width: min(52%, 760px);
      margin-right: auto;
      padding: clamp(44px, 5.2vw, 88px) 8vw clamp(38px, 4vw, 70px);
      text-align: left;
    }

    .heritage-slide__eyebrow {
      margin: 0 0 10px;
      color: var(--hero-bronze);
      font-size: 12px;
      font-weight: 650;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .heritage-slide__ritual {
      display: grid;
      width: min(220px, 62vw);
      margin-bottom: 16px;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 10px;
      color: var(--hero-bronze);
    }

    .heritage-slide__ritual span { height: 1px; background: currentColor; }
    .heritage-slide__ritual b {
      width: 5px;
      height: 5px;
      background: currentColor;
      transform: rotate(45deg);
    }

    .heritage-slide__heading {
      max-width: 13ch;
      margin: 0;
      color: var(--hero-ivory);
      font-family: var(--font-headline, var(--font-heading-family));
      font-size: clamp(34px, 3.25vw, 56px);
      font-weight: 520;
      letter-spacing: -0.035em;
      line-height: 1.02;
      text-wrap: balance;
    }

    .heritage-slide__lead {
      max-width: 52ch;
      margin: 18px 0 0;
      padding-left: 16px;
      border-left: 3px solid var(--hero-bronze);
      color: rgba(247, 244, 234, 0.9);
      font-size: 16px;
      font-weight: 400;
      line-height: 1.5;
    }

    .heritage-slide__actions { display: flex; flex-wrap: nowrap; gap: 10px; margin-top: 22px; }

    .heritage-slide__button {
      display: inline-flex;
      box-sizing: border-box;
      width: max-content;
      max-width: 100%;
      min-height: 44px;
      padding: 9px 16px;
      border: 1px solid var(--hero-ivory);
      border-radius: 2px;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      color: var(--hero-ivory);
      font-size: 14px;
      font-weight: 650;
      letter-spacing: 0.08em;
      white-space: nowrap;
      text-decoration: none;
    }

    .heritage-slide__button--primary { border-color: var(--hero-marigold); background: var(--hero-marigold); color: var(--hero-ink); }
    .heritage-slide__button:hover,
    .heritage-slide__button:focus-visible { border-color: var(--hero-marigold); background: var(--hero-marigold); color: var(--hero-ink); }
    .heritage-slide__button:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

    .hh-swiper-button-next,
    .hh-swiper-button-prev {
      display: flex;
      width: 44px;
      height: 44px;
      padding: 0;
      align-items: center;
      justify-content: center;
      color: #fff;
      background: rgba(20, 37, 21, 0.72);
      border: 0;
      border-radius: 999px;
      cursor: pointer;
      min-width: 44px;
      min-height: 44px;
      position: absolute;
      top: 50%;
      z-index: 3;
    }

    .hh-swiper-pagination {
      pointer-events: none;
    }

    .hh-swiper-button-next {
      right: 16px;
    }

    .hh-swiper-button-prev {
      left: 16px;
    }

    .hh-swiper-autoplay-toggle {
      position: absolute;
      right: 16px;
      bottom: 16px;
      z-index: 3;
      width: 44px;
      min-width: 44px;
      height: 44px;
      min-height: 44px;
      padding: 0;
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 50%;
      color: #fff;
      background: rgba(20, 37, 21, 0.82);
      cursor: pointer;
      font: inherit;
      font-size: 0;
      line-height: 1;
      overflow: hidden;
    }

    .hh-swiper-autoplay-toggle::before {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      display: block;
      box-sizing: border-box;
      color: currentColor;
    }

    .hh-swiper-autoplay-toggle[aria-pressed="true"]::before {
      width: 12px;
      height: 14px;
      background: currentColor;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
      transform: translate(-38%, -50%);
    }

    .hh-swiper-autoplay-toggle[aria-pressed="false"]::before {
      width: 10px;
      height: 14px;
      background: linear-gradient(to right, currentColor 0 30%, transparent 30% 70%, currentColor 70% 100%);
      transform: translate(-50%, -50%);
    }

    .hh-swiper-button-next:focus-visible,
    .hh-swiper-button-prev:focus-visible,
    .hh-swiper-autoplay-toggle:focus-visible {
      outline: 3px solid #fff;
      outline-offset: 3px;
    }

  @media screen and (max-width: 767px) {

    .swiper--homepage-banner,
    .swiper-slide--homepage-banner {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 4;  
      position: relative;
    }

       .swiper--homepage-banner,
    .swiper-slide--homepage-banner {
      width: 100%;
      height: auto;

    }
    .slide-content {
      top: 8%;
      left: max(20px, env(safe-area-inset-left));
      width: min(48%, 210px);
      max-width: 210px;
      transform: none;
    }

    .slide-content--position-right {
      right: auto;
      left: max(20px, env(safe-area-inset-left));
    }

    .slide-content--mobile-wide {
      width: min(calc(100% - 44px), 390px);
      max-width: 390px;
    }

    .slide-content__eyebrow { margin-bottom: 7px; font-size: 12px; }
    .slide-content__heading { max-width: 16ch; font-size: clamp(25px, 6.7vw, 30px); line-height: 1.07; }
    .slide-content__lead { max-width: 38ch; margin-top: 10px; font-size: 16px; line-height: 1.45; }
    .slide-content__offer { min-height: 28px; margin-top: 10px; gap: 9px; }
    .slide-content__price { font-size: 24px; }
    .slide-content__compare-at { font-size: 14px; }
    .slide-content__badge { font-size: 12px; }
    .slide-content__cta { min-height: 44px; margin-top: 12px; padding: 10px 15px; font-size: 14px; }

    .hh-swiper-button-next,
    .hh-swiper-button-prev {
      top: auto;
      bottom: 14px;
      display: flex;
      border: 1px solid rgba(255, 255, 255, 0.8);
      transform: none;
    }

    .hh-swiper-button-prev {
      right: auto;
      left: max(14px, env(safe-area-inset-left));
    }

    .hh-swiper-button-next {
      right: auto;
      left: max(66px, calc(env(safe-area-inset-left) + 66px));
    }

    .hh-swiper-autoplay-toggle {
      right: max(14px, env(safe-area-inset-right));
      top: 50%;
      bottom: auto !important;
      width: 44px;
      min-width: 44px;
      height: 44px;
      min-height: 44px;
      padding: 0;
      border-radius: 50%;
      overflow: hidden;
      font-size: 0;
      line-height: 1;
      transform: translateY(-50%);
    }

    .heritage-slide__scrim {
      background: linear-gradient(180deg, rgba(3, 10, 7, 0.92) 0%, rgba(3, 10, 7, 0.76) 68%, rgba(3, 10, 7, 0.42) 100%);
    }

    .heritage-slide__products {
      right: 0;
      width: 100%;
      height: 52%;
    }

    .heritage-slide__watermark { top: 11%; font-size: clamp(120px, 48vw, 190px); }
    .heritage-slide__content { box-sizing: border-box; width: 100%; padding: 46px 22px 34px; }
    .heritage-slide__eyebrow { font-size: 12px; }
    .heritage-slide__ritual { margin-bottom: 12px; }
    .heritage-slide__heading { max-width: 15ch; font-size: clamp(25px, 6.7vw, 30px); line-height: 1.07; }
    .heritage-slide__lead { max-width: 32ch; margin-top: 12px; font-size: 16px; line-height: 1.45; }
    .heritage-slide__actions { margin-top: 14px; }
    .heritage-slide__button { min-height: 44px; padding: 10px 15px; font-size: 14px; }
  }

  @media screen and (max-width: 767px) and (min-height: 780px) {
    .slide-content { top: 10.5%; }
    .heritage-slide__content { padding-top: 52px; }
  }

  @media screen and (max-width: 430px) {
    .page-header-image-banner,
    .wt-image-banner,
    .swipe-homepage-banner,
    .swiper--homepage-banner,
    .swiper-slide--homepage-banner {
      height: auto;
      aspect-ratio: auto;
    }

    .swiper--homepage-banner,
    .swiper-slide--homepage-banner,
    .homepage-banner-link {
      height: clamp(660px, 165vw, 710px);
      min-height: 660px;
    }

    .swiper-slide--homepage-banner,
    .homepage-banner-link {
      display: grid;
      grid-template-rows: auto minmax(260px, 1fr);
      align-items: stretch;
    }

    .slide-art-stage {
      position: relative;
      grid-row: 2;
      min-height: 260px;
      overflow: hidden;
    }

    .slide-art-stage img {
      position: absolute;
      inset: 0;
      width: 100%;
      max-width: none;
      height: 100%;
      object-fit: cover;
      object-position: center bottom;
    }

    .slide-content,
    .slide-content--position-right,
    .slide-content--mobile-narrow,
    .slide-content--mobile-wide {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      grid-row: 1;
      box-sizing: border-box;
      width: 100%;
      max-width: none;
