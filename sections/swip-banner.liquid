      transform: none;
    }
  }

  @media screen and (max-width: 390px) {
    .heritage-slide__actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  @media screen and (max-width: 359px) {
    .hh-swiper-pagination {
      display: none;
    }
  }

  /* --- TABLET --- */
