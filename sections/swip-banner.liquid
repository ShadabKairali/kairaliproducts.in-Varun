    }

    .heritage-slide__background,
    .heritage-slide__scrim,
    .heritage-slide__products {
      position: relative;
      inset: auto;
      grid-row: 2;
      grid-column: 1;
      width: 100%;
      min-height: 260px;
      height: 100%;
    }

    .heritage-slide__background img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center bottom;
    }

    .heritage-slide__scrim {
      background: linear-gradient(180deg, rgba(3, 10, 7, 0.08), rgba(3, 10, 7, 0.34));
      pointer-events: none;
    }

    .heritage-slide__products {
      overflow: hidden;
    }

    .swiper--homepage-banner .heritage-slide__product--kairoil {
      left: -2%;
