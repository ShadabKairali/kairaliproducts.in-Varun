  <!-- Your JS file (optional if needed for other functions) -->
  <script src="{{ 'page-header-image-banner.js' | asset_url }}" defer></script>

  {% assign width_line = 'hero__wrapper--full' %}

  <page-header-image-banner class="page-header-image-banner {% if section.settings.video_hosted %}page-header-image-banner--video{% endif %}">
    <div
      data-section-id="{{ section.id }}"
      class="wt-image-banner wt-image-banner--header {{ width_line }} {% if settings.animations %}scroll-trigger animate--slide-in{% endif %} {% if settings.disabled_animations_on_mobile %}disabled-on-mobile{% endif %}"
    >
<div class="swipe-homepage-banner page-header-image-banner">
        <div
          id="HomepageBanner-{{ section.id }}"
          class="swiper swiper--homepage-banner"
          role="region"
          aria-roledescription="carousel"
          aria-label="Homepage promotions"
        >
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div
                class="swiper-slide swiper-slide--homepage-banner{% if block.type == 'heritage' %} swiper-slide--heritage{% endif %}"
                role="group"
                aria-roledescription="slide"
                aria-label="{{ forloop.index }} of {{ forloop.length }}"
                data-banner-block="{{ block.id }}"
                {{ block.shopify_attributes }}
              >

                {% if block.type == 'heritage' %}
                  <picture class="heritage-slide__background" aria-hidden="true">
                    <source media="(max-width: 767px)" srcset="{{ 'kairali-home-banner-01-heritage-assortment-mobile-r04_8b0e5c3f-ad6a-45f7-8a13-f8190ad2fb65.webp' | asset_url }}" width="1122" height="1402">
                    <img src="{{ 'kairali-home-banner-01-heritage-assortment-desktop-r04_38f8ff6e-638b-4c7f-ac7f-c3e508acd91e.webp' | asset_url }}" alt="" width="1842" height="854" fetchpriority="high" loading="eager" decoding="async">
                  </picture>
                  <div class="heritage-slide__scrim" aria-hidden="true"></div>
                  <div class="heritage-slide__watermark" aria-hidden="true">1908</div>
                  <div class="heritage-slide__content">
                    <p class="heritage-slide__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                    <span class="heritage-slide__ritual" aria-hidden="true"><span></span><b></b><span></span></span>
                    <h1 class="heritage-slide__heading">{{ block.settings.heading | escape }}</h1>
                    <p class="heritage-slide__lead">{{ block.settings.lead | escape }}</p>
                    <div class="heritage-slide__actions">
                      <a class="heritage-slide__button heritage-slide__button--primary" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label | escape }}</a>
                      <a class="heritage-slide__button" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label | escape }}</a>
                    </div>
                  </div>
                {% else %}
                {% capture fallback_link_label %}Homepage banner slide {{ forloop.index }} of {{ forloop.length }}{% endcapture %}
                {% assign link_label = block.settings.accessible_label | default: block.settings.heading | default: fallback_link_label %}
                {% assign content_tone = block.settings.content_tone | default: 'light' %}
                {% assign content_position = block.settings.content_position | default: 'left' %}
                {% assign mobile_content_width = block.settings.mobile_content_width | default: 'narrow' %}
                {% assign desktop_asset_width = block.settings.desktop_asset_width | default: 1672 %}
                {% assign desktop_asset_height = block.settings.desktop_asset_height | default: 941 %}
                {% assign mobile_asset_width = block.settings.mobile_asset_width | default: 1086 %}
                {% assign mobile_asset_height = block.settings.mobile_asset_height | default: 1448 %}
                {% assign display_price = block.settings.price %}
                {% assign display_compare_at = block.settings.compare_at %}
                {% assign display_badge = block.settings.offer_badge %}
                {% assign commerce_product = block.settings.commerce_product %}
                {% assign commerce_variant = commerce_product.selected_or_first_available_variant %}
                {% if commerce_variant != blank %}
                  {% capture display_price %}{{ commerce_variant.price | money }}{% endcapture %}
                  {% if commerce_variant.compare_at_price > commerce_variant.price %}
                    {% if block.settings.compare_at != blank or block.settings.offer_badge != blank %}
                      {% capture display_compare_at %}{{ commerce_variant.compare_at_price | money }}{% endcapture %}
                      {% assign saving_amount = commerce_variant.compare_at_price | minus: commerce_variant.price %}
                      {% if block.settings.offer_badge contains '%' %}
                        {% assign saving_percentage = saving_amount | times: 100.0 | divided_by: commerce_variant.compare_at_price | round %}
                        {% capture display_badge %}{{ saving_percentage }}% OFF{% endcapture %}
                      {% elsif block.settings.offer_badge contains 'SAVE' %}
                        {% capture display_badge %}SAVE {{ saving_amount | money_without_trailing_zeros }}{% endcapture %}
                      {% endif %}
                    {% else %}
                      {% assign display_compare_at = blank %}
                      {% assign display_badge = blank %}
                    {% endif %}
                  {% else %}
                    {% assign display_compare_at = blank %}
                    {% assign display_badge = blank %}
                  {% endif %}
                {% endif %}
                {% if block.settings.link %}
                  <a class="homepage-banner-link" href="{{ block.settings.link }}" aria-label="{{ link_label }}">
                {% endif %}
<picture class="slide-art-stage">
  {% if block.settings.mobile_asset_filename != blank %}
    <source
      media="(max-width: 767px)"
      srcset="{{ block.settings.mobile_asset_filename | asset_url }}"
      width="{{ mobile_asset_width }}"
      height="{{ mobile_asset_height }}"
    >
  {% elsif block.settings.mobile_image %}
    <source
      media="(max-width: 767px)"
      srcset="{{ block.settings.mobile_image | image_url: width: 480 }} 480w, {{ block.settings.mobile_image | image_url: width: 768 }} 768w, {{ block.settings.mobile_image | image_url: width: 1000 }} 1000w"
      sizes="100vw"
      width="{{ block.settings.mobile_image.width }}"
      height="{{ block.settings.mobile_image.height }}"
    >
  {% endif %}
  {% if block.settings.desktop_asset_filename != blank %}
    <source
      media="(min-width: 768px)"
      srcset="{{ block.settings.desktop_asset_filename | asset_url }}"
      width="{{ desktop_asset_width }}"
      height="{{ desktop_asset_height }}"
    >
  {% else %}
    <source
      media="(min-width: 768px)"
      srcset="{{ block.settings.desktop_image | image_url: width: 1200 }} 1200w, {{ block.settings.desktop_image | image_url: width: 1800 }} 1800w, {{ block.settings.desktop_image | image_url: width: 2400 }} 2400w"
      sizes="100vw"
      width="{{ block.settings.desktop_image.width }}"
      height="{{ block.settings.desktop_image.height }}"
    >
  {% endif %}
  
  {% if block.settings.desktop_asset_filename != blank %}
    <img
      src="{{ block.settings.desktop_asset_filename | asset_url }}"
      alt=""
      width="{{ desktop_asset_width }}"
      height="{{ desktop_asset_height }}"
      loading="lazy"
      decoding="async"
    >
  {% elsif forloop.first %}
    <img 
  src="{{ block.settings.desktop_image | image_url: width: 1800 }}"
  alt=""
  width="{{ block.settings.desktop_image.width }}"
  height="{{ block.settings.desktop_image.height }}"
  fetchpriority="high"
  loading="eager">
  {% else %}
    <img 
    src="{{ block.settings.desktop_image | image_url: width: 1800 }}"
    alt=""
    width="{{ block.settings.desktop_image.width }}"
    height="{{ block.settings.desktop_image.height }}"
    loading="lazy">
  {% endif %}
</picture>
                  {% if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.lead != blank or block.settings.cta_label != blank %}
                    <div class="slide-content slide-content--{{ content_tone }} slide-content--position-{{ content_position }} slide-content--mobile-{{ mobile_content_width }}">
                      {% if block.settings.eyebrow != blank %}<p class="slide-content__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
                      {% if block.settings.heading != blank %}<h2 class="slide-content__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
                      {% if block.settings.lead != blank %}<p class="slide-content__lead">{{ block.settings.lead | escape }}</p>{% endif %}
                      {% if display_price != blank or display_compare_at != blank or display_badge != blank %}
                        <div class="slide-content__offer" aria-label="{{ display_price | append: ' ' | append: display_compare_at | append: ' ' | append: display_badge | strip | escape }}">
                          {% if display_price != blank %}<span class="slide-content__price">{{ display_price | escape }}</span>{% endif %}
                          {% if display_compare_at != blank %}<span class="slide-content__compare-at">{{ display_compare_at | escape }}</span>{% endif %}
                          {% if display_badge != blank %}<span class="slide-content__badge">{{ display_badge | escape }}</span>{% endif %}
                        </div>
                      {% endif %}
                      {% if block.settings.cta_label != blank %}<span class="slide-content__cta" aria-hidden="true">{{ block.settings.cta_label | escape }}</span>{% endif %}
                    </div>
                  {% endif %}
                {% if block.settings.link %}
                  </a>
                {% endif %}
                {% endif %}
              </div>
            {% endfor %}
          </div>

          <button class="hh-swiper-button-next" type="button" aria-label="Next homepage banner">
            <span aria-hidden="true">&#8250;</span>
          </button>
          <button class="hh-swiper-button-prev" type="button" aria-label="Previous homepage banner">
            <span aria-hidden="true">&#8249;</span>
          </button>
          <div class="hh-swiper-pagination"></div>
          <button class="hh-swiper-autoplay-toggle" type="button" aria-pressed="false">
            Pause banners
          </button>
        </div>
      </div>
    </div>
  </page-header-image-banner>

  <!-- ✅ Working Swiper Autoplay JS -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const banner = document.getElementById('HomepageBanner-{{ section.id }}');
      if (!banner || banner.swiper) return;

      const autoplayToggle = banner.querySelector('.hh-swiper-autoplay-toggle');
      const swiper = new Swiper(banner, {
        loop: true,
        autoplay: false,
        pagination: {
          el: banner.querySelector('.hh-swiper-pagination'),
          clickable: false,
        },
        navigation: {
          nextEl: banner.querySelector('.hh-swiper-button-next'),
          prevEl: banner.querySelector('.hh-swiper-button-prev'),
        },
      });

      const setAutoplayState = (isPaused) => {
        autoplayToggle.setAttribute('aria-pressed', String(isPaused));
        autoplayToggle.textContent = isPaused ? 'Play banners' : 'Pause banners';
      };

      const syncSlideFocus = () => {
        swiper.slides.forEach((slide) => {
          const isActive = slide.classList.contains('swiper-slide-active');
          slide.setAttribute('aria-hidden', String(!isActive));
          slide.querySelectorAll('a, button, input, select, textarea, [tabindex]').forEach((control) => {
            if (isActive) {
              control.removeAttribute('tabindex');
            } else {
              control.setAttribute('tabindex', '-1');
            }
          });
        });
      };

      const pagination = banner.querySelector('.hh-swiper-pagination');
      if (pagination) {
        pagination.setAttribute('aria-hidden', 'true');
        pagination.querySelectorAll('.swiper-pagination-bullet').forEach((bullet) => {
          bullet.removeAttribute('role');
          bullet.removeAttribute('aria-label');
          bullet.setAttribute('tabindex', '-1');
        });
      }

      syncSlideFocus();
      swiper.on('slideChangeTransitionEnd', syncSlideFocus);

      setAutoplayState(true);

      autoplayToggle.addEventListener('click', function () {
        if (!swiper.autoplay) return;

        if (swiper.autoplay.running) {
          swiper.autoplay.stop();
          setAutoplayState(true);
        } else {
          swiper.autoplay.start();
          setAutoplayState(false);
        }
      });
      });
  </script>

{% endif %}

